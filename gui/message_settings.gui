								using = highlighted_square_selection
							}
                        }
                    }
                }
            }
        }
    }

	# Smart Notifications mod: Country Watchlist rows (Phase 3, see TODO.md).
	# Modeled on diplomatically_interesting_country_list_item above for the
	# flag/name part (confirmed-working bindings, reused as-is), but with
	# our own checkbox instead of that type's unfinished dropdown -- wired
	# to TWO separate scripted GUIs (common/scripted_guis/watchlist_sgui.txt):
	# one for the click (Execute), a different is_valid-only one for the
	# checked state (IsValid) -- see that file's header comment for why a
	# single SGUI can't do both.
	#
	# Five near-identical types, one per sub-section (see the sub-navigation
	# row and the flowcontainers above) -- GUI item types can't take
	# parameters, so each section needs its own type differing only in the
	# root widget's `visible` filter. The checkbox itself is IDENTICAL
	# across all five: every row's checkbox always means "watched or not,
	# period" (see watchlist_toggle_sgui's own header comment), regardless
	# of which section it's shown in.
	type smart_notifications_watchlist_watched_row = widget {
        size = { 660 44 }
        visible = "[GetScriptedGui('watchlist_is_watched_check_sgui').IsValid(GuiScope.SetRoot(InterestingCountryItem.GetCountry.MakeScope).End)]"

        background = {
            using = entry_bg_simple
        }

        hbox = {

        	widget = {
        		size = { 7 7 }
        	}

        	small_flag = {
                datacontext = "[InterestingCountryItem.GetCountry]"
            }

            textbox = {
                datacontext = "[InterestingCountryItem.GetCountry]"
                text = "[Country.GetNameNoFlag]"
                align = nobaseline
                layoutpolicy_vertical = preferred
                layoutpolicy_horizontal = preferred
                maximumsize = { 590 -1 }
                margin_left = 10
                elide = right
            }

            widget = {
                size = { 60 44 }
                datacontext = "[InterestingCountryItem.GetCountry]"

                checkbutton = {
                    using = check_button
                    size = { 24 24 }
                    parentanchor = center
                    onclick = "[GetScriptedGui('watchlist_toggle_sgui').Execute(GuiScope.SetRoot(Country.MakeScope).End)]"
                    # Deliberately a DIFFERENT scripted_gui than the onclick above --
                    # see common/scripted_guis/watchlist_sgui.txt for why (is_valid
                    # doubles as an execute-gate, so it can't also be the toggle's
                    # own "am I currently watched" query).
                    checked = "[GetScriptedGui('watchlist_is_watched_check_sgui').IsValid(GuiScope.SetRoot(Country.MakeScope).End)]"
                }
            }
        }
    }

	type smart_notifications_watchlist_great_power_row = widget {
        size = { 660 44 }
        visible = "[GetScriptedGui('watchlist_is_great_power_check_sgui').IsValid(GuiScope.SetRoot(InterestingCountryItem.GetCountry.MakeScope).End)]"

