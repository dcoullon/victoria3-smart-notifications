	type smart_notifications_watchlist_neighbor_americas_row = widget {
        size = { 660 44 }
        visible = "[And(GetScriptedGui('watchlist_is_neighbor_check_sgui').IsValid(GuiScope.SetRoot(InterestingCountryItem.GetCountry.MakeScope).End), GetScriptedGui('watchlist_is_in_americas_sgui').IsValid(GuiScope.SetRoot(InterestingCountryItem.GetCountry.MakeScope).End))]"

