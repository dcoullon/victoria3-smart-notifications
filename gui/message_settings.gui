            using = entry_bg_simple
        }

        hbox = {

        	widget = {
        		size = { 7 7 }
        	}

        	small_flag = {
                datacontext = "[InterestingCountryItem.GetCountry]"
            }

            textbox = {
                datacontext = "[InterestingCountryItem.GetCountry]"
                text = "[Country.GetNameNoFlag]"
                align = nobaseline
                layoutpolicy_vertical = preferred
                layoutpolicy_horizontal = preferred
                maximumsize = { 590 -1 }
                margin_left = 10
                elide = right
            }

            widget = {
                size = { 60 44 }
                datacontext = "[InterestingCountryItem.GetCountry]"

                checkbutton = {
                    using = check_button
                    size = { 24 24 }
                    parentanchor = center
                    onclick = "[GetScriptedGui('watchlist_toggle_neighbor_sgui').Execute(GuiScope.SetRoot(Country.MakeScope).End)]"
                    checked = "[GetScriptedGui('watchlist_is_watched_check_sgui').IsValid(GuiScope.SetRoot(Country.MakeScope).End)]"
                }
            }
        }
    }

