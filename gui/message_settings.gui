message_settings_window = {}

types message_settings {
	type message_settings_window = default_popup {
		name = "message_settings_window"
		parentanchor = center

		blockoverride "window_header_name" {
			text = MESSAGE_SETTINGS
		}

		blockoverride "header_close_button_visibility" {
			visible = yes
		}

		blockoverride "header_close_button" {
			onclick = "[ToggleMessageSettings]"
			# Smart Notifications mod: these tab-selection variables persist
			# across the window closing (confirmed live -- see TODO.md Phase 3
			# "reproduced consistently"). Vanilla's own close/reopen handling
			# only knows about its original 3 tab variables, so closing while
			# our new 4th tab is active leaves message_settings_watchlist
			# stuck 'true' with no vanilla code path to clear it, and the next
			# open picks a fallback tab (alerts) without clearing ours,
			# leaving two tabs simultaneously visible. Clear it explicitly on
			# every path that closes this window (see the bottom Close
			# button below too).
			onclick = "[GetVariableSystem.Set('message_settings_watchlist', 'false')]"
		}

		blockoverride "content" {

			flowcontainer = {
				direction = vertical
				resizeparent = yes
				minimumsize = { 700 300 }
				margin_top = 90
				margin_bottom = 30
				margin_left = 14
				margin_right = 14
				spacing = 5

				widget = {
                    size = { 700 44 }

                    tab_buttons = {
                        blockoverride "first_button" {
                            text = "MESSAGE_SETTINGS_NOTIFICATION_TYPES"
                        }
                        blockoverride "first_button_tooltip" {
                            tooltip = "MESSAGE_SETTINGS_NOTIFICATION_TYPES"
                        }
                        blockoverride "first_button_click" {
                            onclick = "[GetVariableSystem.Set('message_settings_notification_types', 'true')]"
                            onclick = "[GetVariableSystem.Set('message_settings_alerts', 'false')]"
                            onclick = "[GetVariableSystem.Set('message_settings_interesting_countries', 'false')]"
                            onclick = "[GetVariableSystem.Set('message_settings_watchlist', 'false')]"
                        }
                        blockoverride "first_button_visibility" {
                            visible = "[GetVariableSystem.HasValue('message_settings_notification_types', 'true')]"
                        }
                        blockoverride "first_button_visibility_checked" {
                            visible = "[Not( GetVariableSystem.HasValue('message_settings_notification_types', 'true') )]"
                        }
                        blockoverride "first_button_selected" {
                            text = "MESSAGE_SETTINGS_NOTIFICATION_TYPES"
                        }

                        blockoverride "second_button" {
                            text = "MESSAGE_SETTINGS_ALERTS"
                        }
                        blockoverride "second_button_tooltip" {
                            tooltip = "MESSAGE_SETTINGS_ALERTS"
                        }
                        blockoverride "second_button_click" {
                            onclick = "[GetVariableSystem.Set('message_settings_notification_types', 'false')]"
                            onclick = "[GetVariableSystem.Set('message_settings_alerts', 'true')]"
                            onclick = "[GetVariableSystem.Set('message_settings_interesting_countries', 'false')]"
                            onclick = "[GetVariableSystem.Set('message_settings_watchlist', 'false')]"
                        }
                        blockoverride "second_button_visibility" {
                            visible = "[GetVariableSystem.HasValue('message_settings_alerts', 'true')]"
                        }
                        blockoverride "second_button_visibility_checked" {
                            visible = "[Not( GetVariableSystem.HasValue('message_settings_alerts', 'true') )]"
                        }
                        blockoverride "second_button_selected" {
                            text = "MESSAGE_SETTINGS_ALERTS"
                        }

                        blockoverride "third_button" {
                            text = "MESSAGE_SETTINGS_DIPLOMATICALLY_INTERESTING"
                        }
                        blockoverride "third_button_tooltip" {
                            tooltip = "MESSAGE_SETTINGS_DIPLOMATICALLY_INTERESTING"
                        }
                        blockoverride "third_button_click" {
                            onclick = "[GetVariableSystem.Set('message_settings_notification_types', 'false')]"
                            onclick = "[GetVariableSystem.Set('message_settings_alerts', 'false')]"
                            onclick = "[GetVariableSystem.Set('message_settings_interesting_countries', 'true')]"
                            onclick = "[GetVariableSystem.Set('message_settings_watchlist', 'false')]"
                        }
                        blockoverride "third_button_visibility" {
                            # Left exactly as vanilla shipped it (hidden, incomplete
                            # Paradox feature -- see docs/engine-notes.md "Two
                            # entirely separate notification systems" / TODO.md
                            # Phase 3). Not repurposing this slot for our own tab,
                            # in case Paradox finishes it in a future patch --
                            # using a genuinely new fourth slot instead (see below).
                            #visible = "[GetVariableSystem.HasValue('message_settings_interesting_countries', 'true')]" # todo PRCAL-26835
                            visible = no

                        }
                        blockoverride "third_button_visibility_checked" {
                            #visible = "[Not( GetVariableSystem.HasValue('message_settings_interesting_countries', 'true') )]" # todo PRCAL-26835
                            visible = no
                        }
                        blockoverride "third_button_selected" {
                            text = "MESSAGE_SETTINGS_DIPLOMATICALLY_INTERESTING"
                        }

                        # Smart Notifications mod: Country Watchlist tab (Phase 3,
                        # see TODO.md). `tab_buttons` supports up to a fifth slot
                        # (confirmed -- gui/country_panel.gui's own tab strip uses
                        # all five), so this is a genuinely new slot, not a
                        # repurposing of the vanilla third one above.
                        blockoverride "fourth_button" {
                            text = "SMART_NOTIFICATIONS_WATCHLIST_TAB"
                        }
                        blockoverride "fourth_button_tooltip" {
                            tooltip = "SMART_NOTIFICATIONS_WATCHLIST_TAB"
                        }
                        blockoverride "fourth_button_click" {
                            onclick = "[GetVariableSystem.Set('message_settings_notification_types', 'false')]"
                            onclick = "[GetVariableSystem.Set('message_settings_alerts', 'false')]"
                            onclick = "[GetVariableSystem.Set('message_settings_interesting_countries', 'false')]"
                            onclick = "[GetVariableSystem.Set('message_settings_watchlist', 'true')]"
                        }
                        blockoverride "fourth_button_visibility" {
                            visible = "[GetVariableSystem.HasValue('message_settings_watchlist', 'true')]"
                        }
                        blockoverride "fourth_button_visibility_checked" {
                            visible = "[Not( GetVariableSystem.HasValue('message_settings_watchlist', 'true') )]"
                        }
                        blockoverride "fourth_button_selected" {
                            text = "SMART_NOTIFICATIONS_WATCHLIST_TAB"
                        }
                    }
                }

                widget = {
                	parentanchor = hcenter
                    size = { 660 44 }
                	background = {
                    	using = entry_bg_simple
                    }

                    hbox = {
						textbox = {
							text = "SETTING_PAUSE_ON_EVENT_MESSAGE_SETTINGS"
							align = nobaseline
							layoutpolicy_vertical = preferred
							layoutpolicy_horizontal = preferred
							maximumsize = { 290 -1 }
							margin_left = 10
							fontsize_min = 14
							elide = right
						}

						widget = {
							size = { 290 44 }
						}

						widget = {
							size = { 60 44 }
							checkbutton = {
								using = check_button
								size = { 24 24 }
								parentanchor = center
								onclick = "[MessageSettingsWindow.TogglePauseOnEvent]"
								checked = "[MessageSettingsWindow.HasPauseOnEvent]"
							}
						}
					}
                }

				flowcontainer = {
					parentanchor = hcenter
					spacing = 7
					margin_bottom = 5
					visible = "[GetVariableSystem.HasValue('message_settings_notification_types', 'true')]"

					textbox = {
						text = "MESSAGE_SETTINGS_SORT_NOTIFICATION_TYPE"
						autoresize = yes
						minimumsize = { 290 -1 }
						maximumsize = { 290 -1 }
						align = nobaseline
						default_format = "#title"
						elide = right
						fontsize_min = 14
					}

					textbox = {
						text = "MESSAGE_SETTINGS_SORT_APPEARANCE"
						autoresize = yes
						minimumsize = { 200 -1 }
						maximumsize = { 200 -1 }
						align = nobaseline
						default_format = "#title"
						elide = right
						fontsize_min = 14
					}

					textbox = {
						text = "MESSAGE_SETTINGS_SORT_PAUSE"
						autoresize = yes
						minimumsize = { 150 -1 }
						maximumsize = { 150 -1 }
						align = right|nobaseline
						default_format = "#title"
						margin_right = 5
						elide = right
						fontsize_min = 14
					}
				}

				flowcontainer = {
                    direction = vertical
                    parentanchor = hcenter
                    visible = "[GetVariableSystem.HasValue('message_settings_alerts', 'true')]"

					flowcontainer = {
	                    direction = vertical
	                    parentanchor = hcenter
	                    visible = "[GetVariableSystem.HasValue('message_settings_alerts', 'true')]"
	                    spacing = 10

	                    widget = {
	                    	size = { 5 5 }
	                    }

	                    ### CURRENT SITUATION LABEL
						widget = {
		                    parentanchor = hcenter
		                    size = { 660 84 }

		                    background = {
		                    	using = entry_bg_simple
		                    }

		                    ### TITLE
		                    textbox = {
		                        parentanchor = vcenter
		                        position = { 20 0 }
		                        text = "MESSAGE_SETTINGS_ALERTS_BUTTON_LABEL"
		                        autoresize = yes
		                        minimumsize = { 290 -1 }
		                        maximumsize = { 290 -1 }
		                        elide = right
		                        fontsize_min = 14
		                        align = nobaseline
		                    }

		                    ### CURRENT SITUTAION LABEL OPTIONS
		                    flowcontainer = {
		                    	parentanchor = vcenter|right
		                    	position = { -20 0 }
		                    	spacing = 10

		                    	### UNREAD (Option)
		                        widget = {
		                        	size = { 150 44 }
		                        	tooltip = "CURRENT_SITUATION_UNREAD_TOOLTIP"

		                        	background = {
		                        		visible = "[Not(MessageSettingsWindow.IsCurrentSituationLabelTotal)]"
		                        		using = paper_bg
		                        	}

		                        	button = {
		                        		visible = "[MessageSettingsWindow.IsCurrentSituationLabelTotal]"
		                        		size = { 100% 100% }
		                        		using = default_button_action
		                        		onclick = "[MessageSettingsWindow.CurrentSituationLabelSelectUnread]"
		                        	}

		                        	textbox = {
		                        		parentanchor = center
		                        		autoresize = yes
		                        		align = nobaseline
		                        		max_width = 150
		                        		elide = right
		                        		fontsize_min = 14
		                        		text = "CURRENT_SITUATION_LABEL_UNREAD"
		                        	}

		                        	icon = {
		                        		visible = "[Not(MessageSettingsWindow.IsCurrentSituationLabelTotal)]"
		                        		using = highlighted_square_selection
		                        	}
		                        }

		                        ### TOTAL (Option)
		                        widget = {
		                        	size = { 150 44 }
		                        	tooltip = "CURRENT_SITUATION_TOTAL_TOOLTIP"

		                        	background = {
		                        		visible = "[MessageSettingsWindow.IsCurrentSituationLabelTotal]"
		                        		using = paper_bg
		                        	}

		                        	button = {
		                        		visible = "[Not(MessageSettingsWindow.IsCurrentSituationLabelTotal)]"
		                        		size = { 100% 100% }
		                        		using = default_button_action
		                        		onclick = "[MessageSettingsWindow.CurrentSituationLabelSelectTotal]"
		                        	}

		                        	textbox = {
		                        		#visible = "[Not(MessageSettingsWindow.IsCurrentSituationLabelTotal)]"
		                        		parentanchor = center
		                        		autoresize = yes
		                        		align = nobaseline
		                        		max_width = 150
		                        		elide = right
		                        		fontsize_min = 14
		                        		text = "CURRENT_SITUATION_LABEL_TOTAL"
		                        	}

		                        	icon = {
		                        		visible = "[MessageSettingsWindow.IsCurrentSituationLabelTotal]"
		                        		using = highlighted_square_selection
		                        	}
		                        }
		                    }
		                }
		            }

					flowcontainer = {
						parentanchor = hcenter
						spacing = 7
						margin_bottom = 5
						margin_top = 10

						textbox = {
							text = "MESSAGE_SETTINGS_SORT_ALERT_NAME"
							autoresize = yes
							minimumsize = { 320 -1 }
							maximumsize = { 320 -1 }
							align = nobaseline
							default_format = "#title"
						}

						textbox = {
							text = "MESSAGE_SETTINGS_SORT_APPEARANCE"
							autoresize = yes
							minimumsize = { 320 -1 }
							maximumsize = { 320 -1 }
							align = nobaseline
							default_format = "#title"
						}
					}
				}

				flowcontainer = {
                    direction = vertical
                    parentanchor = hcenter
                    #visible = "[GetVariableSystem.HasValue('message_settings_interesting_countries', 'true')]" # todo PRCAL-26835
                    visible = no

                    flowcontainer = {
                        parentanchor = hcenter
                        spacing = 7
                        margin_bottom = 5
                        margin_top = 10

                        textbox = {
							text = "MESSAGE_SETTINGS_SORT_ALERT_NAME"
							autoresize = yes
							minimumsize = { 305 -1 }
							maximumsize = { 305 -1 }
							align = nobaseline
							default_format = "#title"
						}

						textbox = {
							text = "MESSAGE_SETTINGS_SORT_APPEARANCE"
							autoresize = yes
							minimumsize = { 335 -1 }
							maximumsize = { 335 -1 }
							align = nobaseline
							default_format = "#title"
						}
                    }
                }

				# Smart Notifications mod: Country Watchlist sub-navigation.
				# tab_buttons (the vanilla component used for the 4 outer tabs
				# above) caps out at 5 slots, already used by our one outer
				# "Watchlist" tab plus the 3 vanilla ones -- no room for 5 MORE
				# outer tabs for the categories. So this is our OWN plain
				# button row, not the vanilla tab_buttons component, switching
				# a second, mod-only GetVariableSystem variable
				# (smart_notifications_watchlist_section) that only matters
				# while the outer Watchlist tab is active. Selected-state
				# visual mirrors the confirmed-working "CURRENT SITUATION
				# LABEL" unread/total selector earlier in this same file
				# (background-swap + button, not a custom widget type).
				flowcontainer = {
					parentanchor = hcenter
					spacing = 5
					margin_bottom = 10
					margin_top = 10
					visible = "[GetVariableSystem.HasValue('message_settings_watchlist', 'true')]"

					widget = {
						size = { 130 32 }
						tooltip = "SMART_NOTIFICATIONS_WATCHLIST_SECTION_WATCHED"

						background = {
							visible = "[Not(Or(GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'great_powers'), Or(GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'neighbors'), Or(GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'rivals'), GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'manual')))))]"
							using = paper_bg
						}

						button = {
							visible = "[Or(GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'great_powers'), Or(GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'neighbors'), Or(GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'rivals'), GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'manual'))))]"
							size = { 100% 100% }
							using = default_button_action
							onclick = "[GetVariableSystem.Set('smart_notifications_watchlist_section', 'watched')]"
						}

						textbox = {
							parentanchor = center
							autoresize = yes
							align = nobaseline
							max_width = 130
							elide = right
							fontsize_min = 14
							text = "SMART_NOTIFICATIONS_WATCHLIST_SECTION_WATCHED"
						}
					}

					widget = {
						size = { 130 32 }
						tooltip = "SMART_NOTIFICATIONS_WATCHLIST_SECTION_GREAT_POWERS"

						background = {
							visible = "[GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'great_powers')]"
							using = paper_bg
						}

						button = {
							visible = "[Not(GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'great_powers'))]"
							size = { 100% 100% }
							using = default_button_action
							onclick = "[GetVariableSystem.Set('smart_notifications_watchlist_section', 'great_powers')]"
						}

						textbox = {
							parentanchor = center
							autoresize = yes
							align = nobaseline
							max_width = 130
							elide = right
							fontsize_min = 14
							text = "SMART_NOTIFICATIONS_WATCHLIST_SECTION_GREAT_POWERS"
						}
					}

					widget = {
						size = { 130 32 }
						tooltip = "SMART_NOTIFICATIONS_WATCHLIST_SECTION_NEIGHBORS"

						background = {
							visible = "[GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'neighbors')]"
							using = paper_bg
						}

						button = {
							visible = "[Not(GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'neighbors'))]"
							size = { 100% 100% }
							using = default_button_action
							onclick = "[GetVariableSystem.Set('smart_notifications_watchlist_section', 'neighbors')]"
						}

						textbox = {
							parentanchor = center
							autoresize = yes
							align = nobaseline
							max_width = 130
							elide = right
							fontsize_min = 14
							text = "SMART_NOTIFICATIONS_WATCHLIST_SECTION_NEIGHBORS"
						}
					}

					widget = {
						size = { 130 32 }
						tooltip = "SMART_NOTIFICATIONS_WATCHLIST_SECTION_RIVALS"

						background = {
							visible = "[GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'rivals')]"
							using = paper_bg
						}

						button = {
							visible = "[Not(GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'rivals'))]"
							size = { 100% 100% }
							using = default_button_action
							onclick = "[GetVariableSystem.Set('smart_notifications_watchlist_section', 'rivals')]"
						}

						textbox = {
							parentanchor = center
							autoresize = yes
							align = nobaseline
							max_width = 130
							elide = right
							fontsize_min = 14
							text = "SMART_NOTIFICATIONS_WATCHLIST_SECTION_RIVALS"
						}
					}

					widget = {
						size = { 130 32 }
						tooltip = "SMART_NOTIFICATIONS_WATCHLIST_SECTION_MANUAL"

						background = {
							visible = "[GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'manual')]"
							using = paper_bg
						}

						button = {
							visible = "[Not(GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'manual'))]"
							size = { 100% 100% }
							using = default_button_action
							onclick = "[GetVariableSystem.Set('smart_notifications_watchlist_section', 'manual')]"
						}

						textbox = {
							parentanchor = center
							autoresize = yes
							align = nobaseline
							max_width = 130
							elide = right
							fontsize_min = 14
							text = "SMART_NOTIFICATIONS_WATCHLIST_SECTION_MANUAL"
						}
					}
				}

				# Smart Notifications mod: Country Watchlist bulk select/
				# deselect buttons (added 2026-09-07, was previously
				# blocked -- see watchlist_sgui.txt's header comment on the
				# bulk-action SGUIs for the confirmed fix). One row per
				# category, each gated to its own section so only the
				# active category's pair shows. `datacontext =
				# "[GetMetaPlayer.GetPlayedOrObservedCountry]"` is the
				# confirmed-real accessor (matches vanilla's own
				# market_panel.gui/right_click_menu.gui/ingame_hud.gui
				# usage) that makes `Country.MakeScope` inside this
				# container resolve to the player, with no row/list
				# involved -- this is what lets the bulk SGUIs below run
				# with root = player. Watched/Manually-Added get no bulk
				# row: Watched's own per-row checkbox IS its removal tool,
				# and Manually Added has no live "who qualifies" set to
				# bulk-act on in the first place.
				flowcontainer = {
					parentanchor = hcenter
					spacing = 10
					margin_bottom = 5
					datacontext = "[GetMetaPlayer.GetPlayedOrObservedCountry]"
					visible = "[And(GetVariableSystem.HasValue('message_settings_watchlist', 'true'), GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'great_powers'))]"

					button = {
						size = { 200 32 }
						using = default_button
						text = "SMART_NOTIFICATIONS_WATCHLIST_SELECT_ALL"
						onclick = "[GetScriptedGui('watchlist_bulk_select_great_power_sgui').Execute(GuiScope.SetRoot(Country.MakeScope).End)]"
					}

					button = {
						size = { 200 32 }
						using = default_button
						text = "SMART_NOTIFICATIONS_WATCHLIST_DESELECT_ALL"
						onclick = "[GetScriptedGui('watchlist_bulk_deselect_great_power_sgui').Execute(GuiScope.SetRoot(Country.MakeScope).End)]"
					}
				}

				flowcontainer = {
					parentanchor = hcenter
					spacing = 10
					margin_bottom = 5
					datacontext = "[GetMetaPlayer.GetPlayedOrObservedCountry]"
					visible = "[And(GetVariableSystem.HasValue('message_settings_watchlist', 'true'), GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'neighbors'))]"

					button = {
						size = { 200 32 }
						using = default_button
						text = "SMART_NOTIFICATIONS_WATCHLIST_SELECT_ALL"
						onclick = "[GetScriptedGui('watchlist_bulk_select_neighbor_sgui').Execute(GuiScope.SetRoot(Country.MakeScope).End)]"
					}

					button = {
						size = { 200 32 }
						using = default_button
						text = "SMART_NOTIFICATIONS_WATCHLIST_DESELECT_ALL"
						onclick = "[GetScriptedGui('watchlist_bulk_deselect_neighbor_sgui').Execute(GuiScope.SetRoot(Country.MakeScope).End)]"
					}
				}

				flowcontainer = {
					parentanchor = hcenter
					spacing = 10
					margin_bottom = 5
					datacontext = "[GetMetaPlayer.GetPlayedOrObservedCountry]"
					visible = "[And(GetVariableSystem.HasValue('message_settings_watchlist', 'true'), GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'rivals'))]"

					button = {
						size = { 200 32 }
						using = default_button
						text = "SMART_NOTIFICATIONS_WATCHLIST_SELECT_ALL"
						onclick = "[GetScriptedGui('watchlist_bulk_select_rival_sgui').Execute(GuiScope.SetRoot(Country.MakeScope).End)]"
					}

					button = {
						size = { 200 32 }
						using = default_button
						text = "SMART_NOTIFICATIONS_WATCHLIST_DESELECT_ALL"
						onclick = "[GetScriptedGui('watchlist_bulk_deselect_rival_sgui').Execute(GuiScope.SetRoot(Country.MakeScope).End)]"
					}
				}

				# Smart Notifications mod: Country Watchlist tab header row.
				flowcontainer = {
					parentanchor = hcenter
					spacing = 7
					margin_bottom = 5
					margin_top = 10
					visible = "[GetVariableSystem.HasValue('message_settings_watchlist', 'true')]"

					textbox = {
						text = "SMART_NOTIFICATIONS_WATCHLIST_COLUMN_COUNTRY"
						autoresize = yes
						minimumsize = { 590 -1 }
						maximumsize = { 590 -1 }
						align = nobaseline
						default_format = "#title"
						elide = right
						fontsize_min = 14
					}

					textbox = {
						text = "SMART_NOTIFICATIONS_WATCHLIST_COLUMN_WATCHED"
						autoresize = yes
						minimumsize = { 60 -1 }
						maximumsize = { 60 -1 }
						align = right|nobaseline
						default_format = "#title"
						elide = right
						fontsize_min = 14
					}
				}

				scrollarea = {
					using = default_list_position
					layoutpolicy_vertical = preferred
					layoutpolicy_horizontal = preferred
					maximumsize = { 684 600 }
					minimumsize = { 684 150 }

					scrollbarpolicy_horizontal = always_off

					scrollbar_vertical = {
						using = vertical_scrollbar
					}

					scrollwidget = {
						container = {
							parentanchor = hcenter
							resizeparent = yes

							flowcontainer = {
								parentanchor = hcenter
								direction = vertical
								spacing = 4
								visible = "[GetVariableSystem.HasValue('message_settings_notification_types', 'true')]"
								datamodel = "[MessageSettingsWindow.GetNotificationSettingsItems]"

								item = {
									notification_type_list_item = {}
								}
							}

							flowcontainer = {
			                    direction = vertical
			                    parentanchor = hcenter
			                    visible = "[GetVariableSystem.HasValue('message_settings_alerts', 'true')]"

                                datamodel = "[MessageSettingsWindow.GetAlertSettingsItems]"

			                    item = {
			                    	alert_type_list_item = {}
			                    }
			                }

			                flowcontainer = {
			                    direction = vertical
			                    parentanchor = hcenter
			                    #visible = "[GetVariableSystem.HasValue('message_settings_interesting_countries', 'true')]" # todo PRCAL-26835
			                    visible = no

                                datamodel = "[MessageSettingsWindow.GetInterestingCountryItems]"

			                    item = {
			                    	diplomatically_interesting_country_list_item = {}
			                    }
			                }

			                # Smart Notifications mod: Country Watchlist lists.
			                # Reuses the vanilla GetInterestingCountryItems datamodel
			                # purely as a country enumeration source (see
			                # TODO.md Phase 3 -- that feature's own dropdown/settings
			                # half is an unfinished Paradox stub, but the underlying
			                # "give me a list of items wrapping a Country" part is
			                # the same mechanism the (working, currently-visible)
			                # first two tabs are built on) -- none of our item
			                # types below use any of that tab's broken
			                # dropdown/GetSetting machinery, just
			                # InterestingCountryItem.GetCountry. Five separate
			                # flowcontainers, one per sub-section (see the
			                # sub-navigation row above) -- each uses the SAME
			                # datamodel (every country in the world) but a
			                # DIFFERENT item type with a different `visible`
			                # filter baked in, since GUI item types can't take
			                # parameters.

			                # Watched (default sub-section, see the fallback
			                # logic on its own nav button above for why this
			                # condition is the negative of the other four).
			                flowcontainer = {
			                    direction = vertical
			                    parentanchor = hcenter
			                    visible = "[And(GetVariableSystem.HasValue('message_settings_watchlist', 'true'), Not(Or(GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'great_powers'), Or(GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'neighbors'), Or(GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'rivals'), GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'manual'))))))]"

			                    datamodel = "[MessageSettingsWindow.GetInterestingCountryItems]"

			                    item = {
			                    	smart_notifications_watchlist_watched_row = {}
			                    }
			                }

			                # Great Powers -- true live check (see
			                # watchlist_is_great_power_check_sgui), browses
			                # anyone currently a Great Power, watched or not.
			                flowcontainer = {
			                    direction = vertical
			                    parentanchor = hcenter
			                    visible = "[And(GetVariableSystem.HasValue('message_settings_watchlist', 'true'), GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'great_powers'))]"

			                    datamodel = "[MessageSettingsWindow.GetInterestingCountryItems]"

			                    item = {
			                    	smart_notifications_watchlist_great_power_row = {}
			                    }
			                }

			                # Neighbors -- true live adjacency check (see
			                # watchlist_is_neighbor_check_sgui in watchlist_sgui.txt).
			                # Grouped by continent (added 2026-09-07): a colonial
			                # player can be genuinely adjacent to dozens of
			                # countries across totally different regions (real,
			                # confirmed via testing, not a bug -- see TODO.md), so
			                # this is one long flat list otherwise. Four
			                # sub-groups, each its own flowcontainer + header
			                # label + item type combining the neighbor check with
			                # a continent check (watchlist_is_in_<region>_sgui) --
			                # still ONE tab/section, just visually grouped within
			                # it, per the user's "don't add more tabs" ask.
			                # `GetGeographicRegion(...).GetName` reuses vanilla's
			                # own continent localization directly rather than
			                # hardcoding new header text.
			                flowcontainer = {
			                    direction = vertical
			                    parentanchor = hcenter
			                    visible = "[And(GetVariableSystem.HasValue('message_settings_watchlist', 'true'), GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'neighbors'))]"

			                    textbox = {
			                    	text = "[GetGeographicRegion('geographic_region_europe').GetName]"
			                    	autoresize = yes
			                    	align = nobaseline
			                    	default_format = "#title"
			                    	margin_top = 6
			                    	margin_left = 5
			                    }

			                    datamodel = "[MessageSettingsWindow.GetInterestingCountryItems]"

			                    item = {
			                    	smart_notifications_watchlist_neighbor_europe_row = {}
			                    }
			                }

			                flowcontainer = {
			                    direction = vertical
			                    parentanchor = hcenter
			                    visible = "[And(GetVariableSystem.HasValue('message_settings_watchlist', 'true'), GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'neighbors'))]"

			                    textbox = {
			                    	text = "[GetGeographicRegion('geographic_region_africa').GetName]"
			                    	autoresize = yes
			                    	align = nobaseline
			                    	default_format = "#title"
			                    	margin_top = 6
			                    	margin_left = 5
			                    }

			                    datamodel = "[MessageSettingsWindow.GetInterestingCountryItems]"

			                    item = {
			                    	smart_notifications_watchlist_neighbor_africa_row = {}
			                    }
			                }

			                flowcontainer = {
			                    direction = vertical
			                    parentanchor = hcenter
			                    visible = "[And(GetVariableSystem.HasValue('message_settings_watchlist', 'true'), GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'neighbors'))]"

			                    textbox = {
			                    	text = "[GetGeographicRegion('geographic_region_asia').GetName]"
			                    	autoresize = yes
			                    	align = nobaseline
			                    	default_format = "#title"
			                    	margin_top = 6
			                    	margin_left = 5
			                    }

			                    datamodel = "[MessageSettingsWindow.GetInterestingCountryItems]"

			                    item = {
			                    	smart_notifications_watchlist_neighbor_asia_row = {}
			                    }
			                }

			                flowcontainer = {
			                    direction = vertical
			                    parentanchor = hcenter
			                    visible = "[And(GetVariableSystem.HasValue('message_settings_watchlist', 'true'), GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'neighbors'))]"

			                    textbox = {
			                    	text = "[GetGeographicRegion('geographic_region_americas').GetName]"
			                    	autoresize = yes
			                    	align = nobaseline
			                    	default_format = "#title"
			                    	margin_top = 6
			                    	margin_left = 5
			                    }

			                    datamodel = "[MessageSettingsWindow.GetInterestingCountryItems]"

			                    item = {
			                    	smart_notifications_watchlist_neighbor_americas_row = {}
			                    }
			                }

			                # Rivals -- true live rivalry check (see
			                # watchlist_is_rival_check_sgui in watchlist_sgui.txt).
			                flowcontainer = {
			                    direction = vertical
			                    parentanchor = hcenter
			                    visible = "[And(GetVariableSystem.HasValue('message_settings_watchlist', 'true'), GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'rivals'))]"

			                    datamodel = "[MessageSettingsWindow.GetInterestingCountryItems]"

			                    item = {
			                    	smart_notifications_watchlist_rival_row = {}
			                    }
			                }

			                # Manually Added -- deliberately UNFILTERED for now
			                # (shows every country, not just current
			                # watched_manually ones) since there's no search box
			                # yet to narrow it down another way -- this is the
			                # only sub-section where a brand new, not-yet-watched,
			                # not-a-Great-Power country can actually be added.
			                # See TODO.md for the search-box follow-up.
			                flowcontainer = {
			                    direction = vertical
			                    parentanchor = hcenter
			                    visible = "[And(GetVariableSystem.HasValue('message_settings_watchlist', 'true'), GetVariableSystem.HasValue('smart_notifications_watchlist_section', 'manual'))]"

			                    datamodel = "[MessageSettingsWindow.GetInterestingCountryItems]"

			                    item = {
			                    	smart_notifications_watchlist_manual_row = {}
			                    }
			                }

						}
					}
				}

				flowcontainer = {
					visible = "[MessageSettingsWindow.HasSingleShownItem]"
					parentanchor = hcenter
					spacing = 10
					margin_top = 10

					button_primary = {
						onclick = "[MessageSettingsWindow.RemoveSingleShownItem]"
						size = { 630 40 }
						text = "SHOW_ALL_MESSAGE_SETTINGS"
					}
				}

				flowcontainer = {
					parentanchor = hcenter
					spacing = 10
					margin_top = 10

					button = {
                        visible = "[GetVariableSystem.HasValue('message_settings_notification_types', 'true')]"
						onclick = "[MessageSettingsWindow.ResetNotificationSettings]"
						size = { 310 40 }
						text = "RESET_TO_DEFAULT"
						using = default_button
					}

					button = {
                        visible = "[GetVariableSystem.HasValue('message_settings_alerts', 'true')]"
						onclick = "[MessageSettingsWindow.ResetAlertSettings]"
						size = { 310 40 }
						text = "RESET_TO_DEFAULT"
						using = default_button
					}

					button = {
						onclick = "[ToggleMessageSettings]"
						# See the header_close_button override above for why.
						onclick = "[GetVariableSystem.Set('message_settings_watchlist', 'false')]"
						size = { 310 40 }
						text = "CLOSE_LABEL"
						using = default_button
					}
				}
			}
		}
	}

	type notification_type_list_item = widget {
		size = { 660 44 }
		visible = "[MessageSettingsWindow.ShouldBeShown(NotificationSettingsItem.GetTag)]"

		background = {
			using = entry_bg_simple
		}

		hbox = {
			textbox = {
				text = "[NotificationSettingsItem.GetName]"
				align = nobaseline
				layoutpolicy_vertical = preferred
				layoutpolicy_horizontal = preferred
				maximumsize = { 290 -1 }
				margin_left = 10
				fontsize_min = 14
				elide = right
			}

			widget = {
				size = { 290 44 }

				dropdown_menu_standard = {
					parentanchor = vcenter

					blockoverride "dropdown_properties"
					{
						datamodel = "[NotificationSettingsItem.GetValidOptions]"
						onselectionchanged = "[NotificationSettingsItem.OnSelectOption]"
					}

					blockoverride "dropdown_size"
					{
						size = { 290 32 }
					}

					blockoverride "dropdown_list_maxsize"
					{
						size = { 290 600 }
					}

					blockoverride "dropdown_active_item_properties"
					{
						text_single = {
							parentanchor = vcenter
							position = { 10 0 }
							autoresize = yes
							align = nobaseline
							default_format = "#clickable"
							text = "[NotificationSettingsItem.GetCurrentOption.GetNameWithConcept]"
						}

						text_single = {
							parentanchor = right|vcenter
							position = { -30 0 }
							autoresize = yes
							align = right|nobaseline
							default_format = "#title"
							text = "MESSAGE_SETTINGS_DEFAULT"
							visible = "[NotificationSettingsItem.GetCurrentOption.IsDefault]"
						}
					}

					blockoverride "dropdown_item_properties"
					{
						widget = {
							size = { 100% 100% }

							background = {
								visible = "[ObjectsEqual(NotificationOptionItem.AccessSelf, NotificationSettingsItem.GetCurrentOption)]"
								using = paper_bg
							}

							hbox = {
								layoutpolicy_horizontal = expanding
								margin_right = 10

								text_single = {
									layoutpolicy_horizontal = expanding
									align = nobaseline
									margin_left = 10
									default_format = "#clickable"
									text = "[NotificationOptionItem.GetNameWithConcept]"
								}

								expand = {}

								text_single = {
									layoutpolicy_horizontal = expanding
									align = right|nobaseline
									default_format = "#title"
									text = "MESSAGE_SETTINGS_DEFAULT"
									visible = "[NotificationOptionItem.IsDefault]"
								}
							}

							icon = {
								visible = "[ObjectsEqual(NotificationOptionItem.AccessSelf, NotificationSettingsItem.GetCurrentOption)]"
								using = highlighted_square_selection
							}
						}
					}
				}
			}

			widget = {
				size = { 60 44 }
				checkbutton = {
					using = check_button
					size = { 24 24 }
					parentanchor = center
					onclick = "[NotificationSettingsItem.ToggleAutoPause]"
					checked = "[NotificationSettingsItem.HasAutoPause]"
				}
			}
		}
	}

