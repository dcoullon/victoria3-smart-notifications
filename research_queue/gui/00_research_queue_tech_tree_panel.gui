# GENERATED by tools/gen_research_queue_probe.py from the installed game's
# gui/tech_tree.gui and common/technology/technologies. Do not edit by hand:
# change the generator and re-run.
# Redefines the vanilla types tech_tree_panel and queued_technology; the 00_
# prefix makes this file load before tech_tree.gui, so these definitions win
# (docs/engine-notes.md, "A partial .gui override works").
types research_queue_types
{
	type tech_tree_panel = fullscreen_block_window {
		name = "tech_tree_panel"
		enabled = yes

		blockoverride "animation_state_block" {
			state = {
				name = _show
				start_sound = {
					soundeffect = "event:/SFX/UI/SideBar/technology"
				}
				start_sound = {
					soundeffect = "snapshot:/Dynamic/mute_world_80"
				}
				start_sound = {
					soundeffect = "snapshot:/Dynamic/mute_vfx_war_100"

				}
			}

			state = {
				name = _hide
				start_sound = {
					soundeffect = "event:/SFX/UI/SideBar/technology_stop"
				}
			}
		}
		
		blockoverride "window_header_name"
		{
			text = "TECH_TREE"
		}

		blockoverride "fixed_top" {
			hbox = {
				spacing = 20
				margin = { 28 10 }
				margin_bottom = 15
				layoutpolicy_horizontal = growing
				
				### HAS NO RESEARCH
				hbox = {
					layoutpolicy_horizontal = growing
					layoutstretchfactor_horizontal = 5
					visible = "[Not(GetPlayer.HasCurrentlyResearchedTechnology)]"
					margin = { 25 12 }
					
					using = entry_bg_fancy
					
					vbox = {
						layoutpolicy_horizontal = growing
						
						textbox = {
							layoutpolicy_horizontal = growing
							autoresize = yes
							text = "NO_ACTIVE_RESEARCH"
							using = fontsize_large
							align = left|nobaseline
							alpha = 0.5
						}
						textbox = {
							layoutpolicy_horizontal = growing
							autoresize = yes
							text = "RESEARCH_PANEL"
							using = fontsize_xxl
							align = left|nobaseline
							
							using = look_at_me_text_animation
						}
					}
				}
				
				### CURRENT RESEARCH
				hbox = {
					layoutpolicy_horizontal = growing
					layoutstretchfactor_horizontal = 5
					visible = "[GetPlayer.HasCurrentlyResearchedTechnology]"
					datacontext = "[AccessPlayer.AccessCurrentlyResearchedTechnology]"

					spacing = 10
					margin = { 15 7 }
					margin_right = 25

					background = {
						using = entry_bg_simple
					}
					
					widget = {
						size = { 80 80 }

						icon = {
							parentanchor = center
							using = rotate_glow_animation_02
							size = { 250% 250% }
						}

						icon = {
							size = { 100% 100% }
							parentanchor = center
							texture = "[Technology.GetTexture]"

							tooltipwidget = {
								FancyTooltip_Technology = {}
							}

							### ERA
							widget = {
								size = { 25 25 }
								parentanchor = hcenter|bottom
							
								icon = {
									size = { 100% 100% }
									texture = "gfx/interface/backgrounds/round_button_bg.dds"
								}
								
								textbox = {
									text = "TECHNOLOGY_TYPE_DESCRIPTION"
									align = center|nobaseline
									parentanchor = center
								}
							}
						}

						button_icon_cancel = {
							parentanchor = top|right
							size = { 25 25 }
							tooltip = "REMOVE_CURRENT_RESEARCH_TECH_FROM_QUEUE"
							using = tooltip_ne
							onclick = "[Execute(Technology.RemoveFromQueue(GetPlayer.Self))]"
							enabled = "[IsValid(Technology.RemoveFromQueue(GetPlayer.Self))]"
						}
					}
				
					### TEXT + PROGRESS
					vbox = {
						spacing = 5
						
						hbox = {
							layoutpolicy_horizontal = expanding

							textbox = {
								max_width = 250
								autoresize = yes
								align = nobaseline
								raw_text = "#variable [Technology.GetNameNoFormatting]#!"
								using = fontsize_large
								using = elide_fontsize_min

								tooltipwidget = {
									FancyTooltip_Technology = {}
								}
							}

							expand = {}

							textbox = {
								visible = "[Or(And(GreaterThan_CFixedPoint(Technology.GetProgress(GetPlayer.Self), '(CFixedPoint)0'), Not(Technology.HasResearchedTech(GetPlayer.Self))), GreaterThan_CFixedPoint(GetPlayer.GetMinWeeklyTechnologyProgressForTech(Technology.Self), '(CFixedPoint)0'))]"
								max_width = 150
								autoresize = yes
								margin_left = 10
								align = right|nobaseline
								using = elide_fontsize_min
								tooltip = "TECHNOLOGY_GAIN_BREAKDOWN"
								text = "TECHNOLOGY_PROGRESS_TIME_LEFT"
							}
						}

						### PROGRESS
						default_progressbar_horizontal = {
							visible = "[Or(And(GreaterThan_CFixedPoint(Technology.GetProgress(GetPlayer.Self), '(CFixedPoint)0'), Not(Technology.HasResearchedTech(GetPlayer.Self))), GreaterThan_CFixedPoint(GetPlayer.GetMinWeeklyTechnologyProgressForTech(Technology.Self), '(CFixedPoint)0'))]"
							layoutpolicy_horizontal = growing
							size = { 400 25 }
							tooltip = "TECHNOLOGY_GAIN_BREAKDOWN"

							blockoverride "values" {
								max = "[FixedPointToFloat(Technology.GetCost(GetPlayer.Self))]"
								value = "[FixedPointToFloat(Technology.GetProgress(GetPlayer.Self))]"
							}

							textbox = {
								margin_right = 10
								parentanchor = vcenter|right
								align = nobaseline
								autoresize = yes
								text = "TECHNOLOGY_PROGRESS_WITH_GAIN_NO_TOOLTIP"
							}
						}
					}

					# RQ: the controller, BEFORE the queue row in the widget tree, so the
					# states it triggers on the row and on the overflow list (after the
					# row) run in that order. Outside every datamodel, so it fires once.
					widget = {
						name = "rq_controller"
						size = { 1 1 }
						state = { name = rq_go_up_1  duration = 0  alpha = 1
							on_start = "[GetScriptedGui('rq_probe_drop_up_1').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_dump')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_up_1')]"
							next = rq_after
						}
						state = { name = rq_go_up_2  duration = 0  alpha = 1
							on_start = "[GetScriptedGui('rq_probe_drop_up_2').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_dump')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_up_2')]"
							next = rq_after
						}
						state = { name = rq_go_up_3  duration = 0  alpha = 1
							on_start = "[GetScriptedGui('rq_probe_drop_up_3').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_dump')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_up_3')]"
							next = rq_after
						}
						state = { name = rq_go_up_4  duration = 0  alpha = 1
							on_start = "[GetScriptedGui('rq_probe_drop_up_4').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_dump')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_up_4')]"
							next = rq_after
						}
						state = { name = rq_go_up_5  duration = 0  alpha = 1
							on_start = "[GetScriptedGui('rq_probe_drop_up_5').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_dump')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_up_5')]"
							next = rq_after
						}
						state = { name = rq_go_down_2  duration = 0  alpha = 1
							on_start = "[GetScriptedGui('rq_probe_drop_down_2').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_dump')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_down_2')]"
							next = rq_after
						}
						state = { name = rq_go_down_3  duration = 0  alpha = 1
							on_start = "[GetScriptedGui('rq_probe_drop_down_3').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_dump')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_down_3')]"
							next = rq_after
						}
						state = { name = rq_go_down_4  duration = 0  alpha = 1
							on_start = "[GetScriptedGui('rq_probe_drop_down_4').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_dump')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_down_4')]"
							next = rq_after
						}
						state = { name = rq_go_down_5  duration = 0  alpha = 1
							on_start = "[GetScriptedGui('rq_probe_drop_down_5').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_dump')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_down_5')]"
							next = rq_after
						}
						state = { name = rq_noop  duration = 0  alpha = 1
							on_start = "[GetScriptedGui('rq_probe_drop_noop').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						state = { name = rq_badx  duration = 0  alpha = 1
							on_start = "[GetScriptedGui('rq_probe_drop_badx').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						# A second later, after the commands ran: dump the queue again.
						state = { name = rq_after  duration = 1  alpha = 1
							on_finish = "[GetScriptedGui('rq_probe_after').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							on_finish = "[PdxGuiTriggerAllAnimations('rq_dump')]"
						}

						# Every direct or indirect prerequisite pair, "prerequisite>dependent"
						# by tech name, from the game's common/technology/technologies at
						# generation time. Built when the panel is created and on every drop.
						widget = {
							size = { 1 1 }
							state = { name = rq_edges  trigger_on_create = yes  duration = 0  alpha = 1
