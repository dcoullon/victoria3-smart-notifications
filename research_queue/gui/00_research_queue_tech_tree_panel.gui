									# Probe readout: research progress, so a move that loses it shows.
									textbox = {
										parentanchor = bottom|left
										autoresize = yes
										align = nobaseline
										raw_text = "#v [Technology.GetProgress(GetPlayer.Self)|0]#!"
									}

									# Probe buttons. N = ResearchWithUnlocks (vanilla's plain click).
									# B = remove then re-add in ONE click: tests command ordering.
									button_icon_round = {
										parentanchor = bottom|right
										size = { 26 26 }
										position = { -28 0 }
										onclick = "[GetScriptedGui('rq_probe_now').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('t', Technology.MakeScope).End)]"
										onclick = "[PdxGuiTriggerAllAnimations('rq_dump')]"
										onclick = "[Execute(Technology.ResearchWithUnlocks(GetPlayer.Self))]"
										onclick = "[PdxGuiTriggerAllAnimations('rq_after')]"
										textbox = { parentanchor = center  autoresize = yes  align = nobaseline  raw_text = "N" }
									}
									button_icon_round = {
										parentanchor = bottom|right
										size = { 26 26 }
										onclick = "[GetScriptedGui('rq_probe_back').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('t', Technology.MakeScope).End)]"
										onclick = "[PdxGuiTriggerAllAnimations('rq_dump')]"
										onclick = "[Execute(Technology.RemoveFromQueue(GetPlayer.Self))]"
										onclick = "[Execute(Technology.AddToQueueWithUnlocks(GetPlayer.Self))]"
										onclick = "[PdxGuiTriggerAllAnimations('rq_after')]"
										textbox = { parentanchor = center  autoresize = yes  align = nobaseline  raw_text = "B" }
									}
							}
						}
					}

