							}
						}
					}

					# RQ: the zone right of the last shown tech ("after the last shown"),
					# the controller (outside every datamodel, so it fires once), the
					# blocked-move message, and a hidden copy of the overflow list so
					# the techs beyond the shown ones exist as widgets and can be re-queued.
					widget = {
						size = { 60 80 }
						alwaystransparent = no
						drop_target = {
							accept_draggable_id = "rq_tech"
							on_receive_drop = "[PdxGuiTriggerAllAnimations(Select_CString(EqualTo_int32(GetDraggedDatacontext('Technology').GetResearchQueuePosition(GetPlayer.Self), '(int32)1'), 'rq_go_1_end', Select_CString(EqualTo_int32(GetDraggedDatacontext('Technology').GetResearchQueuePosition(GetPlayer.Self), '(int32)2'), 'rq_go_2_end', Select_CString(EqualTo_int32(GetDraggedDatacontext('Technology').GetResearchQueuePosition(GetPlayer.Self), '(int32)3'), 'rq_go_3_end', Select_CString(EqualTo_int32(GetDraggedDatacontext('Technology').GetResearchQueuePosition(GetPlayer.Self), '(int32)4'), 'rq_go_4_end', Select_CString(EqualTo_int32(GetDraggedDatacontext('Technology').GetResearchQueuePosition(GetPlayer.Self), '(int32)5'), 'rq_go_5_end', Select_CString(EqualTo_int32(GetDraggedDatacontext('Technology').GetResearchQueuePosition(GetPlayer.Self), '(int32)6'), 'rq_go_6_end', 'rq_noop')))))))]"
						}

						textbox = {
							visible = "[GetVariableSystem.Exists('rq_msg')]"
							position = { 150 0 }
							size = { 220 80 }
							multiline = yes
							align = vcenter|nobaseline
							raw_text = "#R [GetVariableSystem.Get('rq_msg')]#!"
						}

						widget = {
							name = "rq_controller"
							size = { 1 1 }
							state = { name = rq_noop  duration = 0  alpha = 1
								on_start = "[GetScriptedGui('rq_probe_drop_noop').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
