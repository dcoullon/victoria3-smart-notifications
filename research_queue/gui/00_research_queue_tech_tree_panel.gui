							size = { 200% 1350 }
						}
						icon = {
							using = tech_tree_divider
							position = { 0 2200 }
							size = { 200% 950 }
						}
						icon = {
							using = tech_tree_divider
							position = { 0 4060 }
							size = { 200% 500 }
						}
					}

					blockoverride "starting_pan_position" {
						pan_position = "[GetDefine('NGUI', 'TECH_TREE_PRODUCTION_INITIAL_POSITION')]"
					}
				}
				tech_tree_graph = {
					name = "tech_tree_panel_military"
					visible = "[InformationPanel.IsTabSelected('military')]"
