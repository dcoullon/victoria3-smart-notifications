							size = { 25 25 }
							tooltip = "REMOVE_CURRENT_RESEARCH_TECH_FROM_QUEUE"
							using = tooltip_ne
							onclick = "[Execute(Technology.RemoveFromQueue(GetPlayer.Self))]"
							enabled = "[IsValid(Technology.RemoveFromQueue(GetPlayer.Self))]"
						}
