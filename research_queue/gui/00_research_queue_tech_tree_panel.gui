					# RQ: the zone right of the last shown tech ("after the last shown"),
					# holding a hidden copy of the overflow list, AFTER the row in the
					# tree, so the techs beyond the shown ones exist as widgets and are
					# re-queued after the shown ones.
					widget = {
						size = { 60 80 }
						alwaystransparent = no
						drop_target = {
							accept_draggable_id = "rq_tech"
							on_receive_drop = "[PdxGuiTriggerAllAnimations(Select_CString(EqualTo_string(GetDraggedDatacontext('Technology').GetNameNoFormatting, GetVariableSystem.Get('rq_xname')), Select_CString(LessThan_int32(GetDraggedDatacontext('Technology').GetResearchQueuePosition(GetPlayer.Self), '(int32)5'), 'rq_go_down_5', 'rq_noop'), 'rq_badx'))]"
