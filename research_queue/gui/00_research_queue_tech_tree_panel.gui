				### SEARCH
				search_bar = {
					parentanchor = top|right
					position = { -62 11 }
					datacontext = "[TechTreePanel.GetSearchBar]"

					blockoverride "editbox_background" {
						background = {
							margin = { -1 -1 }
							using = entry_bg_simple_solid
						}

						background = {
							using = text_edit_bg
						}
					}
				}

				### SEARCH RESULTS DROPDOWN
				search_bar_results = {
					parentanchor = top|right
					position = { -62 56 }
					datacontext = "[TechTreePanel.GetSearchBar]"

					blockoverride "result_tooltip" {
						visible = "[Not(StringIsEmpty(SearchResult.GetKey))]"
						datacontext = "[GetTechnology(SearchResult.GetKey)]"

						tooltipwidget = {
							FancyTooltip_Technology = {}
						}
					}
				}

				container = {
					parentanchor = right
					position = { -10 10 }

					button_icon_reset = {
						visible = "[InformationPanel.IsTabSelected('production')]"
						using = tooltip_se
						tooltip = "TOOLTIP_RESET"
						onclick = "[TechTreePanel.ResetProductionView]"
						size = { 42 42 }
					}

					button_icon_reset = {
						visible = "[InformationPanel.IsTabSelected('military')]"
