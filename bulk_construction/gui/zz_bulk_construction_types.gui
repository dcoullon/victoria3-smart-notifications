# Bulk Construction -- PROBE BUILD. Queues nothing; it only writes to
# debug.log. See docs/bulk-construction-spec.md for the design this is
# testing and for the three questions this one launch answers.
#
# This file deliberately does NOT override gui/map_list_panel.gui as a whole.
# It redefines a single `type` from it (build_building_map_list_panel,
# vanilla gui/map_list_panel.gui:1091-1123) from our own file, which is
# UNPROVEN in this engine. Probe question 1 is exactly whether that works:
# if the probe row below appears in the construction panel, a mod can
# redefine one type in isolation and our patch surface is 33 lines instead
# of 5212. If it does not appear (or error.log complains about a duplicate
# type), we fall back to a whole-file override.
#
# Everything outside the "### BC PROBE" markers is copied verbatim from
# vanilla and must stay that way -- redefining a type replaces it wholesale,
# so anything not copied is lost.

types map_list_panel_types {
	type build_building_map_list_panel = map_list_panel {
		name = "build_building_map_list_panel"
		datamodel_reuse_widgets = yes

		blockoverride "headers" {
			direction = vertical

			### BC PROBE -- start ####################################
			# Probe question 2: does GetDataModelSize over the panel's own
			# valid-option datamodel give the same M the player sees as rows?
			# The screenshot answers it: this number vs. the rows below.
			flowcontainer = {
				direction = horizontal
				parentanchor = hcenter
				spacing = 8
				margin = { 10 4 }
				# GetPlayer.MakeScope has no vanilla precedent; this is the
				# pattern already proven in gui/message_settings.gui.
				datacontext = "[GetMetaPlayer.GetPlayedOrObservedCountry]"

				textbox = {
					autoresize = yes
					align = nobaseline
					raw_text = "#BOLD BC#! valid [GetDataModelSize(MapListPanel.AccessValidOptions)] / failed [GetDataModelSize(MapListPanel.AccessFailedOptions)] / invalid [GetDataModelSize(MapListPanel.AccessInvalidOptions)]"
				}

				button = {
					size = { 150 28 }
					using = default_button
					text = "BC_PROBE_FIRE_BUTTON"
					tooltip = "BC_PROBE_FIRE_BUTTON_TOOLTIP"
					# Sets the latch AND logs one click marker, so the log can
					# be segmented per click rather than read as one blob.
					onclick = "[GetScriptedGui('bc_probe_click_sgui').Execute(GuiScope.SetRoot(Country.MakeScope).End)]"
					onclick = "[GetVariableSystem.Set('bc_probe_fire', 'go')]"
				}
			}

			# Probe question 3, the one that matters: does a datamodel
			# container whose items fire on creation iterate the valid options
			# EXACTLY ONCE per click, or does it free-run every frame?
			#
			# This container only exists while 'bc_probe_fire' is set, and it
			# clears that variable a fraction of a second after it is created
			# -- a latch, not a flag. If the latch holds, debug.log gets
			# exactly one BC_PROBE|state line per valid state per click. If it
			# free-runs, it gets thousands, and this whole architecture is
			# dead and we fall back to the script route in the spec's section 2.
			#
			# Nothing here builds anything. The real version replaces the
			# scripted GUI calls below with [MapListOption.OnClick]; that
			# substitution is NOT made until this probe comes back clean.
			widget = {
				size = { 1 1 }
				visible = "[GetVariableSystem.HasValue('bc_probe_fire', 'go')]"

				state = {
					name = bc_latch_clear
					trigger_on_create = yes
					duration = 0.05
					on_finish = "[GetVariableSystem.Clear('bc_probe_fire')]"
				}

				### A -- every valid option, unguarded.
				flowcontainer = {
					direction = vertical
					datamodel = "[MapListPanel.AccessValidOptions]"

					item = {
						widget = {
							size = { 1 1 }
							datacontext = "[MapListOption.AccessBuildingData.AccessState]"

							state = {
								name = bc_fire
								trigger_on_create = yes
								on_finish = "[GetScriptedGui('bc_probe_state_sgui').Execute(GuiScope.SetRoot(State.MakeScope).End)]"
							}
						}
					}
				}

				### B -- probe question 5, and the reason this block exists.
				# The vanilla + button gates on `enabled = [MapListOption.CanClick]`
				# (map_list_panel.gui:229, inherited unchanged by the construction
				# row). `enabled` is a WIDGET property: it stops a human clicking,
				# it does not stop us calling OnClick from a state. So if the valid
				# list can ever contain a non-clickable option, firing OnClick
				# across the whole list would do something the player is not
				# allowed to do -- which is the one thing this mod must never do.
				# Counting B against A says whether valid implies clickable.
				# The real build carries this guard regardless of the answer.
				flowcontainer = {
					direction = vertical
					datamodel = "[MapListPanel.AccessValidOptions]"

					item = {
						widget = {
							size = { 1 1 }
							visible = "[MapListOption.CanClick]"
							datacontext = "[MapListOption.AccessBuildingData.AccessState]"

							state = {
								name = bc_fire_clickable
								trigger_on_create = yes
								on_finish = "[GetScriptedGui('bc_probe_clickable_sgui').Execute(GuiScope.SetRoot(State.MakeScope).End)]"
							}
						}
					}
				}

				### C -- probe question 4, and the control for B.
				# Hard-coded invisible. If any BC_PROBE|hidden line appears,
				# `visible` does NOT prevent trigger_on_create from firing --
				# which would mean B's guard is decorative AND the latch above
				# is not a latch at all. Expected count: zero. This is the
				# single line in the log that would invalidate the design.
				flowcontainer = {
					direction = vertical
					datamodel = "[MapListPanel.AccessValidOptions]"

					item = {
						widget = {
							size = { 1 1 }
							visible = no
							datacontext = "[MapListOption.AccessBuildingData.AccessState]"

							state = {
								name = bc_fire_hidden
								trigger_on_create = yes
								on_finish = "[GetScriptedGui('bc_probe_hidden_sgui').Execute(GuiScope.SetRoot(State.MakeScope).End)]"
							}
						}
					}
				}
			}
			### BC PROBE -- end ######################################

			construction_filters = {}
			construction_headers_condensed = {
				visible = "[Not(GetVariableSystem.Exists('construction_list_toggle_full_or_condensed'))]"
			}
			construction_headers_full = {
				visible = "[GetVariableSystem.Exists('construction_list_toggle_full_or_condensed')]"
			}
		}

		blockoverride "item" {
			item = {
				container = {
					min_width = @panel_width

					construction_interaction_item_condensed = {
						visible = "[Not(GetVariableSystem.Exists('construction_list_toggle_full_or_condensed'))]"
					}

					construction_interaction_item_full = {
						visible = "[GetVariableSystem.Exists('construction_list_toggle_full_or_condensed')]"
					}
				}
			}
		}
	}
}
