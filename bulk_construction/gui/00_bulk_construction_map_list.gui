# Bulk Construction -- the whole mod's GUI, in one file.
#
# It redefines ONE vanilla type, build_building_map_list_panel (vanilla
# gui/map_list_panel.gui:1091-1123), from our own file. No vanilla file is
# overridden, so the patch-fragility surface is this ~35-line type rather
# than 5,212 lines of copied panel.
#
# THE FILENAME IS LOAD-BEARING. The engine keeps the FIRST definition of a
# type that it reads, and files are read in name order, so `00_` sorts ahead
# of vanilla's `map_list_panel.gui` and wins. An identical earlier attempt
# named `zz_bulk_construction_types.gui` sorted AFTER it and silently lost --
# it parsed with no errors and the panel simply rendered vanilla's version.
# Confirmed 2026-09-16 by launching both at once and labelling them
# differently. This convention is also what the Community Mod Framework uses
# (`00_MPM_building_browser_panel.gui`). Do not rename this file.
#
# @constants are file-scoped, so vanilla's @panel_width is not visible here.
# Ours must stay equal to it (gui/map_list_panel.gui:3); asserted by
# check_references.check_bc_panel_width_matches_vanilla.
@bc_panel_width = 540

types map_list_panel_types {
	type build_building_map_list_panel = map_list_panel {
		name = "build_building_map_list_panel"
		datamodel_reuse_widgets = yes

		blockoverride "headers" {
			direction = vertical

			construction_filters = {}
			### BULK BUILD -- start ##################################
			# Below the filters on purpose: this acts on whatever the filters
			# above are currently showing, so it must read as their consequence.
			#
			# It builds by triggering the game's OWN + button
			# (MapListOption.OnClick, gui/map_list_panel.gui:230) once per
			# valid row, per level. Nothing here decides what may be built,
			# what it costs, or who pays -- that is the whole no-cheat claim
			# (docs/bulk-construction-spec.md section 1a), and it is why this
			# iterates AccessValidOptions and never the Failed or Invalid
			# lists.
			#
			# MEASURED 2026-09-16, and the reason it is safe to wire OnClick
			# here at all: one PdxGuiTriggerAllAnimations press produced
			# exactly one pass -- 123 firings against a panel reading
			# "valid 123", in a single burst, with nothing before or after.
			# The earlier trigger_on_create version fired 777 times unprompted
			# across four panel rebuilds; see docs/engine-notes.md
			# "visible does not gate widget creation".
			# Our own collapsible section, built from vanilla's section header
			# exactly as construction_filters builds "Filters" (map_list_panel.gui
			# :2436). Collapsed by default ('bc_open' unset): Build All is not the
			# most frequent action when building (user call, 2026-11-12). The
			# header is the ONE place the mod's name appears in this area; the
			# labels below are untagged. Hiding the controls does not stop the
			# row workers further down from existing: they are triggered by the
			# build buttons, which can only be clicked while the section is open.
			section_header_button = {
				blockoverride "left_text" {
					text = "BC_SECTION_TITLE"
					fontsize_min = 12
					elide = right
				}

				blockoverride "right_text" {
					section_header_right_text = {
						text = "BC_SECTION_SUMMARY"
					}
				}

				blockoverride "onclick" {
					onclick = "[GetVariableSystem.Toggle('bc_open')]"
				}

				blockoverride "onclick_showmore" {
					visible = "[Not(GetVariableSystem.Exists('bc_open'))]"
				}

				blockoverride "onclick_showless" {
					visible = "[GetVariableSystem.Exists('bc_open')]"
				}
			}

			flowcontainer = {
				visible = "[GetVariableSystem.Exists('bc_open')]"
				direction = vertical
				parentanchor = hcenter
				margin = { 10 4 }
				spacing = 4

				flowcontainer = {
					direction = horizontal
					parentanchor = hcenter
					spacing = 6
					# The selected level is marked with vanilla's own
					# `highlighted_square_selection` template (gui/shared/selections.gui),
					# used the same way vanilla marks a selected default_button at
					# gui/building_browser_panel.gui:961-976. Templates are global,
					# unlike @constants -- confirmed by vanilla `using =` it across
					# 10+ files. This used to point at a hand-written
					# `buttons/button_selected_frame.dds`, which does not exist in the
					# game: no texture, no error.log line, no highlight. Guarded now by
					# check_references.check_gui_textures_exist.

					textbox = {
						autoresize = yes
						align = nobaseline
						parentanchor = vcenter
						text = "BC_LEVELS_LABEL"
					}

					button = {
						size = { 52 28 }
						using = default_button
						text = "BC_LEVELS_1"
						onclick = "[GetVariableSystem.Set('bc_levels', '1')]"

						icon = {
							visible = "[Not(Or(GetVariableSystem.HasValue('bc_levels', '5'), GetVariableSystem.HasValue('bc_levels', '10')))]"
							using = highlighted_square_selection
						}
					}
					button = {
						size = { 52 28 }
						using = default_button
						text = "BC_LEVELS_5"
						onclick = "[GetVariableSystem.Set('bc_levels', '5')]"

						icon = {
							visible = "[GetVariableSystem.HasValue('bc_levels', '5')]"
							using = highlighted_square_selection
						}
					}
					button = {
						size = { 52 28 }
						using = default_button
						text = "BC_LEVELS_10"
						onclick = "[GetVariableSystem.Set('bc_levels', '10')]"

						icon = {
							visible = "[GetVariableSystem.HasValue('bc_levels', '10')]"
							using = highlighted_square_selection
						}
					}
				}

				# Efficiency filter (docs/bulk-construction-spec.md section 5a).
				# Tickbox: 'bc_eff_on' exists = ticked. Threshold: 'bc_eff' holds
				# one of '10' '20' ... '100' as a string, and UNSET MEANS 70 (the
				# default), the same way an unset 'bc_levels' means 1 above. The
				# variable system has no arithmetic, so -/+ walk a fixed ladder.
				# The ladder here, the label, and the comparison in the row
				# workers below must agree; check_bc_efficiency_ladder asserts it.
				flowcontainer = {
					direction = horizontal
					parentanchor = hcenter
					spacing = 6

					checkbutton = {
						using = check_button
						size = { 24 24 }
						parentanchor = vcenter
						onclick = "[GetVariableSystem.Toggle('bc_eff_on')]"
						checked = "[GetVariableSystem.Exists('bc_eff_on')]"
						tooltip = "BC_EFF_TOOLTIP"
					}

					textbox = {
						autoresize = yes
						align = nobaseline
						parentanchor = vcenter
						text = "BC_EFF_LABEL"
						tooltip = "BC_EFF_TOOLTIP"
					}

					button = {
						size = { 28 28 }
						using = default_button
						raw_text = "-"
						enabled = "[And(GetVariableSystem.Exists('bc_eff_on'), Not(GetVariableSystem.HasValue('bc_eff', '10')))]"
						onclick = "[GetVariableSystem.Set('bc_eff', Select_CString(GetVariableSystem.HasValue('bc_eff', '100'), '90', Select_CString(GetVariableSystem.HasValue('bc_eff', '90'), '80', Select_CString(GetVariableSystem.HasValue('bc_eff', '80'), '70', Select_CString(GetVariableSystem.HasValue('bc_eff', '60'), '50', Select_CString(GetVariableSystem.HasValue('bc_eff', '50'), '40', Select_CString(GetVariableSystem.HasValue('bc_eff', '40'), '30', Select_CString(GetVariableSystem.HasValue('bc_eff', '30'), '20', Select_CString(GetVariableSystem.HasValue('bc_eff', '20'), '10', Select_CString(GetVariableSystem.HasValue('bc_eff', '10'), '10', '60'))))))))))]"
					}

					textbox = {
						size = { 44 28 }
						align = center|nobaseline
						parentanchor = vcenter
						text = "BC_EFF_VALUE"
					}

					button = {
						size = { 28 28 }
						using = default_button
						raw_text = "+"
						enabled = "[And(GetVariableSystem.Exists('bc_eff_on'), Not(GetVariableSystem.HasValue('bc_eff', '100')))]"
						onclick = "[GetVariableSystem.Set('bc_eff', Select_CString(GetVariableSystem.HasValue('bc_eff', '10'), '20', Select_CString(GetVariableSystem.HasValue('bc_eff', '20'), '30', Select_CString(GetVariableSystem.HasValue('bc_eff', '30'), '40', Select_CString(GetVariableSystem.HasValue('bc_eff', '40'), '50', Select_CString(GetVariableSystem.HasValue('bc_eff', '50'), '60', Select_CString(GetVariableSystem.HasValue('bc_eff', '60'), '70', Select_CString(GetVariableSystem.HasValue('bc_eff', '80'), '90', Select_CString(GetVariableSystem.HasValue('bc_eff', '90'), '100', Select_CString(GetVariableSystem.HasValue('bc_eff', '100'), '100', '80'))))))))))]"
					}
				}

				# 500 wide, not the original 420: the translations run up to ~11%%
				# longer than English (Russian and Polish are the worst), and this
				# label has to fit a three-digit count too. Vanilla's own filter row
				# above sets minimumsize 554 (@panel_width_plus_14), so 500 is
				# comfortably inside the panel.
				#
				# Queue cap (spec section 5a): each build button is disabled at
				# 10,000+ government constructions. `enabled` re-reads the count
				# every frame, so every press checks the live queue first. One
				# press can still overshoot by up to one press; accepted. The
				# 10000 here and in the tooltip's cap condition must match;
				# check_bc_efficiency_ladder asserts it.
				button = {
					visible = "[Not(Or(GetVariableSystem.HasValue('bc_levels', '5'), GetVariableSystem.HasValue('bc_levels', '10')))]"
					enabled = "[LessThan_int32(GetPlayer.GetNumGovernmentConstructionsInQueue, '(int32)10000')]"
					size = { 500 30 }
					using = default_button
					text = "BC_BUILD_BUTTON_1"
					tooltip = "BC_BUILD_TOOLTIP_1"
					onclick = "[PdxGuiTriggerAllAnimations('bc_build_1')]"
				}
				button = {
					visible = "[GetVariableSystem.HasValue('bc_levels', '5')]"
					enabled = "[LessThan_int32(GetPlayer.GetNumGovernmentConstructionsInQueue, '(int32)10000')]"
					size = { 500 30 }
					using = default_button
					text = "BC_BUILD_BUTTON_5"
					tooltip = "BC_BUILD_TOOLTIP_5"
					onclick = "[PdxGuiTriggerAllAnimations('bc_build_1')]"
					onclick = "[PdxGuiTriggerAllAnimations('bc_build_2')]"
					onclick = "[PdxGuiTriggerAllAnimations('bc_build_3')]"
					onclick = "[PdxGuiTriggerAllAnimations('bc_build_4')]"
					onclick = "[PdxGuiTriggerAllAnimations('bc_build_5')]"
				}
				button = {
					visible = "[GetVariableSystem.HasValue('bc_levels', '10')]"
					enabled = "[LessThan_int32(GetPlayer.GetNumGovernmentConstructionsInQueue, '(int32)10000')]"
					size = { 500 30 }
					using = default_button
					text = "BC_BUILD_BUTTON_10"
					tooltip = "BC_BUILD_TOOLTIP_10"
					onclick = "[PdxGuiTriggerAllAnimations('bc_build_1')]"
					onclick = "[PdxGuiTriggerAllAnimations('bc_build_2')]"
					onclick = "[PdxGuiTriggerAllAnimations('bc_build_3')]"
					onclick = "[PdxGuiTriggerAllAnimations('bc_build_4')]"
					onclick = "[PdxGuiTriggerAllAnimations('bc_build_5')]"
					onclick = "[PdxGuiTriggerAllAnimations('bc_build_6')]"
					onclick = "[PdxGuiTriggerAllAnimations('bc_build_7')]"
					onclick = "[PdxGuiTriggerAllAnimations('bc_build_8')]"
					onclick = "[PdxGuiTriggerAllAnimations('bc_build_9')]"
					onclick = "[PdxGuiTriggerAllAnimations('bc_build_10')]"
				}
			}

			# The workers. One hidden row per valid option, each carrying one
			# state per level. They do nothing until a button triggers a state
			# by name -- there is deliberately no trigger_on_create anywhere.
			#
			# Each of these carried a mirrored bc_log_N state that counted the
			# build calls into debug.log while the mechanism was unproven. That
			# question is settled (docs/bulk-construction-spec.md section 4) and
			# the instrumentation is gone, so the build we playtest is now
			# byte-identical to the build that ships. To count again:
			# `git show 17faaec -- bulk_construction/` has it.
			#
			# Efficiency filter (spec section 5a): bc_build_N no longer calls
			# OnClick itself. It triggers bc_do_N (which does) or bc_skip
			# (which does nothing) on the child `bc_gate`, picking by name with
			# Select_CString -- the same computed-name trigger Smart Treaties
			# uses (engine-notes "Branches must be separate states"); a widget
			# state has no condition field of its own. Unticked, the condition
			# is always true and this is the old behaviour.
			#
			# GetConstructionEfficiencyForBuildingType is a SIGNED MODIFIER, not
			# a multiplier: 0 is normal, -0.30 is a 30% penalty, -0.95 the
			# floor (vanilla compares it to 0 and prints it "-30%",
			# gui/construction_queue.gui:462). The first build compared it to
			# 0.35 and so skipped every row (playtest 2026-11-12). The player
			# sets "70%" meaning effective efficiency, so the chain maps ladder
			# step T to the modifier T-1 ('70' -> -0.30, unset -> -0.30). All
			# ten copies must stay identical apart from N
			# (check_bc_efficiency_ladder).
			#
			# Every state here carries `duration = 0  alpha = 1`, a no-op on a
			# 1x1 widget, because a triggered state with no property logs
			# "Animation triggered has no valid state properties" per row per
			# level (580 error.log lines in that playtest).
			widget = {
				size = { 1 1 }

				flowcontainer = {
					direction = vertical
					datamodel = "[MapListPanel.AccessValidOptions]"

					item = {
						widget = {
							size = { 1 1 }

							state = {
								name = bc_build_1
								on_start = "[PdxGuiWidget.FindChild('bc_gate').TriggerAnimation(Select_CString(Or(Not(GetVariableSystem.Exists('bc_eff_on')), GreaterThanOrEqualTo_CFixedPoint(MapListOption.GetBuildingData.GetState.GetConstructionEfficiencyForBuildingType(MapListOption.GetBuildingData.GetBuilding.GetBuildingType), Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '10'), '(CFixedPoint)-0.90', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '20'), '(CFixedPoint)-0.80', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '30'), '(CFixedPoint)-0.70', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '40'), '(CFixedPoint)-0.60', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '50'), '(CFixedPoint)-0.50', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '60'), '(CFixedPoint)-0.40', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '80'), '(CFixedPoint)-0.20', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '90'), '(CFixedPoint)-0.10', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '100'), '(CFixedPoint)0', '(CFixedPoint)-0.30'))))))))))), 'bc_do_1', 'bc_skip'))]"
								duration = 0
								alpha = 1
							}

							state = {
								name = bc_build_2
								on_start = "[PdxGuiWidget.FindChild('bc_gate').TriggerAnimation(Select_CString(Or(Not(GetVariableSystem.Exists('bc_eff_on')), GreaterThanOrEqualTo_CFixedPoint(MapListOption.GetBuildingData.GetState.GetConstructionEfficiencyForBuildingType(MapListOption.GetBuildingData.GetBuilding.GetBuildingType), Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '10'), '(CFixedPoint)-0.90', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '20'), '(CFixedPoint)-0.80', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '30'), '(CFixedPoint)-0.70', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '40'), '(CFixedPoint)-0.60', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '50'), '(CFixedPoint)-0.50', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '60'), '(CFixedPoint)-0.40', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '80'), '(CFixedPoint)-0.20', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '90'), '(CFixedPoint)-0.10', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '100'), '(CFixedPoint)0', '(CFixedPoint)-0.30'))))))))))), 'bc_do_2', 'bc_skip'))]"
								duration = 0
								alpha = 1
							}

							state = {
								name = bc_build_3
								on_start = "[PdxGuiWidget.FindChild('bc_gate').TriggerAnimation(Select_CString(Or(Not(GetVariableSystem.Exists('bc_eff_on')), GreaterThanOrEqualTo_CFixedPoint(MapListOption.GetBuildingData.GetState.GetConstructionEfficiencyForBuildingType(MapListOption.GetBuildingData.GetBuilding.GetBuildingType), Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '10'), '(CFixedPoint)-0.90', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '20'), '(CFixedPoint)-0.80', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '30'), '(CFixedPoint)-0.70', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '40'), '(CFixedPoint)-0.60', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '50'), '(CFixedPoint)-0.50', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '60'), '(CFixedPoint)-0.40', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '80'), '(CFixedPoint)-0.20', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '90'), '(CFixedPoint)-0.10', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '100'), '(CFixedPoint)0', '(CFixedPoint)-0.30'))))))))))), 'bc_do_3', 'bc_skip'))]"
								duration = 0
								alpha = 1
							}

							state = {
								name = bc_build_4
								on_start = "[PdxGuiWidget.FindChild('bc_gate').TriggerAnimation(Select_CString(Or(Not(GetVariableSystem.Exists('bc_eff_on')), GreaterThanOrEqualTo_CFixedPoint(MapListOption.GetBuildingData.GetState.GetConstructionEfficiencyForBuildingType(MapListOption.GetBuildingData.GetBuilding.GetBuildingType), Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '10'), '(CFixedPoint)-0.90', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '20'), '(CFixedPoint)-0.80', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '30'), '(CFixedPoint)-0.70', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '40'), '(CFixedPoint)-0.60', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '50'), '(CFixedPoint)-0.50', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '60'), '(CFixedPoint)-0.40', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '80'), '(CFixedPoint)-0.20', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '90'), '(CFixedPoint)-0.10', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '100'), '(CFixedPoint)0', '(CFixedPoint)-0.30'))))))))))), 'bc_do_4', 'bc_skip'))]"
								duration = 0
								alpha = 1
							}

							state = {
								name = bc_build_5
								on_start = "[PdxGuiWidget.FindChild('bc_gate').TriggerAnimation(Select_CString(Or(Not(GetVariableSystem.Exists('bc_eff_on')), GreaterThanOrEqualTo_CFixedPoint(MapListOption.GetBuildingData.GetState.GetConstructionEfficiencyForBuildingType(MapListOption.GetBuildingData.GetBuilding.GetBuildingType), Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '10'), '(CFixedPoint)-0.90', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '20'), '(CFixedPoint)-0.80', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '30'), '(CFixedPoint)-0.70', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '40'), '(CFixedPoint)-0.60', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '50'), '(CFixedPoint)-0.50', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '60'), '(CFixedPoint)-0.40', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '80'), '(CFixedPoint)-0.20', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '90'), '(CFixedPoint)-0.10', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '100'), '(CFixedPoint)0', '(CFixedPoint)-0.30'))))))))))), 'bc_do_5', 'bc_skip'))]"
								duration = 0
								alpha = 1
							}

							state = {
								name = bc_build_6
								on_start = "[PdxGuiWidget.FindChild('bc_gate').TriggerAnimation(Select_CString(Or(Not(GetVariableSystem.Exists('bc_eff_on')), GreaterThanOrEqualTo_CFixedPoint(MapListOption.GetBuildingData.GetState.GetConstructionEfficiencyForBuildingType(MapListOption.GetBuildingData.GetBuilding.GetBuildingType), Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '10'), '(CFixedPoint)-0.90', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '20'), '(CFixedPoint)-0.80', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '30'), '(CFixedPoint)-0.70', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '40'), '(CFixedPoint)-0.60', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '50'), '(CFixedPoint)-0.50', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '60'), '(CFixedPoint)-0.40', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '80'), '(CFixedPoint)-0.20', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '90'), '(CFixedPoint)-0.10', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '100'), '(CFixedPoint)0', '(CFixedPoint)-0.30'))))))))))), 'bc_do_6', 'bc_skip'))]"
								duration = 0
								alpha = 1
							}

							state = {
								name = bc_build_7
								on_start = "[PdxGuiWidget.FindChild('bc_gate').TriggerAnimation(Select_CString(Or(Not(GetVariableSystem.Exists('bc_eff_on')), GreaterThanOrEqualTo_CFixedPoint(MapListOption.GetBuildingData.GetState.GetConstructionEfficiencyForBuildingType(MapListOption.GetBuildingData.GetBuilding.GetBuildingType), Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '10'), '(CFixedPoint)-0.90', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '20'), '(CFixedPoint)-0.80', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '30'), '(CFixedPoint)-0.70', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '40'), '(CFixedPoint)-0.60', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '50'), '(CFixedPoint)-0.50', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '60'), '(CFixedPoint)-0.40', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '80'), '(CFixedPoint)-0.20', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '90'), '(CFixedPoint)-0.10', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '100'), '(CFixedPoint)0', '(CFixedPoint)-0.30'))))))))))), 'bc_do_7', 'bc_skip'))]"
								duration = 0
								alpha = 1
							}

							state = {
								name = bc_build_8
								on_start = "[PdxGuiWidget.FindChild('bc_gate').TriggerAnimation(Select_CString(Or(Not(GetVariableSystem.Exists('bc_eff_on')), GreaterThanOrEqualTo_CFixedPoint(MapListOption.GetBuildingData.GetState.GetConstructionEfficiencyForBuildingType(MapListOption.GetBuildingData.GetBuilding.GetBuildingType), Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '10'), '(CFixedPoint)-0.90', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '20'), '(CFixedPoint)-0.80', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '30'), '(CFixedPoint)-0.70', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '40'), '(CFixedPoint)-0.60', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '50'), '(CFixedPoint)-0.50', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '60'), '(CFixedPoint)-0.40', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '80'), '(CFixedPoint)-0.20', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '90'), '(CFixedPoint)-0.10', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '100'), '(CFixedPoint)0', '(CFixedPoint)-0.30'))))))))))), 'bc_do_8', 'bc_skip'))]"
								duration = 0
								alpha = 1
							}

							state = {
								name = bc_build_9
								on_start = "[PdxGuiWidget.FindChild('bc_gate').TriggerAnimation(Select_CString(Or(Not(GetVariableSystem.Exists('bc_eff_on')), GreaterThanOrEqualTo_CFixedPoint(MapListOption.GetBuildingData.GetState.GetConstructionEfficiencyForBuildingType(MapListOption.GetBuildingData.GetBuilding.GetBuildingType), Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '10'), '(CFixedPoint)-0.90', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '20'), '(CFixedPoint)-0.80', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '30'), '(CFixedPoint)-0.70', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '40'), '(CFixedPoint)-0.60', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '50'), '(CFixedPoint)-0.50', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '60'), '(CFixedPoint)-0.40', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '80'), '(CFixedPoint)-0.20', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '90'), '(CFixedPoint)-0.10', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '100'), '(CFixedPoint)0', '(CFixedPoint)-0.30'))))))))))), 'bc_do_9', 'bc_skip'))]"
								duration = 0
								alpha = 1
							}

							state = {
								name = bc_build_10
								on_start = "[PdxGuiWidget.FindChild('bc_gate').TriggerAnimation(Select_CString(Or(Not(GetVariableSystem.Exists('bc_eff_on')), GreaterThanOrEqualTo_CFixedPoint(MapListOption.GetBuildingData.GetState.GetConstructionEfficiencyForBuildingType(MapListOption.GetBuildingData.GetBuilding.GetBuildingType), Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '10'), '(CFixedPoint)-0.90', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '20'), '(CFixedPoint)-0.80', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '30'), '(CFixedPoint)-0.70', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '40'), '(CFixedPoint)-0.60', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '50'), '(CFixedPoint)-0.50', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '60'), '(CFixedPoint)-0.40', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '80'), '(CFixedPoint)-0.20', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '90'), '(CFixedPoint)-0.10', Select_CFixedPoint(GetVariableSystem.HasValue('bc_eff', '100'), '(CFixedPoint)0', '(CFixedPoint)-0.30'))))))))))), 'bc_do_10', 'bc_skip'))]"
								duration = 0
								alpha = 1
							}

							# The gate: one OnClick state per level, plus a no-op.
							# Ten distinct names rather than one, so that ten
							# levels triggered in one press are ten triggers and
							# never one animation restarted.
							widget = {
								name = "bc_gate"
								size = { 1 1 }

								state = {
									name = bc_skip
									duration = 0
									alpha = 1
								}
								state = {
									name = bc_do_1
									on_start = "[MapListOption.OnClick]"
									duration = 0
									alpha = 1
								}
								state = {
									name = bc_do_2
									on_start = "[MapListOption.OnClick]"
									duration = 0
									alpha = 1
								}
								state = {
									name = bc_do_3
									on_start = "[MapListOption.OnClick]"
									duration = 0
									alpha = 1
								}
								state = {
									name = bc_do_4
									on_start = "[MapListOption.OnClick]"
									duration = 0
									alpha = 1
								}
								state = {
									name = bc_do_5
									on_start = "[MapListOption.OnClick]"
									duration = 0
									alpha = 1
								}
								state = {
									name = bc_do_6
									on_start = "[MapListOption.OnClick]"
									duration = 0
									alpha = 1
								}
								state = {
									name = bc_do_7
									on_start = "[MapListOption.OnClick]"
									duration = 0
									alpha = 1
								}
								state = {
									name = bc_do_8
									on_start = "[MapListOption.OnClick]"
									duration = 0
									alpha = 1
								}
								state = {
									name = bc_do_9
									on_start = "[MapListOption.OnClick]"
									duration = 0
									alpha = 1
								}
								state = {
									name = bc_do_10
									on_start = "[MapListOption.OnClick]"
									duration = 0
									alpha = 1
								}
							}
						}
					}
				}
			}
			### BULK BUILD -- end ####################################

			construction_headers_condensed = {
				visible = "[Not(GetVariableSystem.Exists('construction_list_toggle_full_or_condensed'))]"
			}
			construction_headers_full = {
				visible = "[GetVariableSystem.Exists('construction_list_toggle_full_or_condensed')]"
			}
		}

		blockoverride "item" {
			item = {
				container = {
					min_width = @bc_panel_width

					construction_interaction_item_condensed = {
						visible = "[Not(GetVariableSystem.Exists('construction_list_toggle_full_or_condensed'))]"
					}

					construction_interaction_item_full = {
						visible = "[GetVariableSystem.Exists('construction_list_toggle_full_or_condensed')]"
					}
				}
			}
		}
	}
}
