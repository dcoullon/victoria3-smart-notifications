# Bulk Construction -- LOAD-ORDER PROBE, added 2026-09-16.
#
# Tests whether a mod can redefine ONE vanilla `type` from its own file
# instead of copying all 5,212 lines of gui/map_list_panel.gui.
#
# An earlier attempt at exactly this failed, in a file named
# zz_bulk_construction_types.gui. The Community Mod Framework does the same
# thing successfully and names its files `00_MPM_building_browser_panel.gui`
# -- a `00_` prefix, sorting BEFORE the vanilla file that declares the type.
# That fits the earlier failure precisely if the engine keeps the FIRST
# definition it reads: `zz_` sorted after vanilla and lost, `00_` sorts before
# it and should win.
#
# So this file carries the same type and the same probe as our full override,
# labelled BC2 instead of BC. Exactly one of them can win, and the label on
# screen says which:
#
#   row reads "BC"  -> the whole-file override won; this mechanism does not
#                      work, and the 5,212-line copy stays.
#   row reads "BC2" -> this file won; the override can be deleted outright
#                      and the mod's patch-fragility surface goes to ~35 lines.
#
# Either way the probe button works, so the latch/CanClick/visible questions
# get answered in the same launch.
#
# @constants are file-scoped (docs/engine-notes.md), so vanilla's @panel_width
# is not visible here -- hence our own copy. Must equal vanilla's
# gui/map_list_panel.gui:3.
@bc2_panel_width = 540

types map_list_panel_types {
	type build_building_map_list_panel = map_list_panel {
		name = "build_building_map_list_panel"
		datamodel_reuse_widgets = yes

		blockoverride "headers" {
			direction = vertical

			construction_filters = {}
			### BC PROBE -- start ####################################
			# Placed BELOW the filters on purpose (user, 2026-09-16): the bulk
			# action reads the filters, so it must not sit above them.
			#
			# FIRING MECHANISM CHANGED 2026-09-16 after the first probe came
			# back fatal. The previous version fired items via
			# `trigger_on_create` inside a container gated by `visible`.
			# Measured result: 777 firings in four bursts, one full pass every
			# time the panel rebuilt, with NO click -- and 237 of them from a
			# container hard-coded `visible = no`. So `visible` does not gate
			# widget creation, the CanClick guard was decorative and the latch
			# was never a latch. With OnClick wired in, that would have queued
			# hundreds of buildings unprompted.
			#
			# This version fires nothing on creation. The items sit idle and
			# only act when the button triggers their named state by hand, via
			# PdxGuiTriggerAllAnimations (vanilla: gui/character_panel.gui:582).
			# A click should now produce exactly one pass, and no click should
			# produce nothing at all.
			flowcontainer = {
				direction = horizontal
				parentanchor = hcenter
				spacing = 8
				margin = { 10 4 }
				datacontext = "[GetMetaPlayer.GetPlayedOrObservedCountry]"

				textbox = {
					autoresize = yes
					align = nobaseline
					# No |= formatter: it renders the count as "+57".
					raw_text = "#BOLD BC2#! valid [GetDataModelSize(MapListPanel.AccessValidOptions)] / failed [GetDataModelSize(MapListPanel.AccessFailedOptions)] / invalid [GetDataModelSize(MapListPanel.AccessInvalidOptions)]"
				}

				# Fires the three counters below, by triggering their state.
				button = {
					size = { 120 28 }
					using = default_button
					text = "BC_PROBE_FIRE_BUTTON"
					tooltip = "BC_PROBE_FIRE_BUTTON_TOOLTIP"
					onclick = "[PdxGuiTriggerAllAnimations('bc_fire')]"
				}

				# Separate button, one onclick only. The previous probe logged
				# ZERO click markers, and could not distinguish "the scripted
				# GUI call failed" from "the button was never pressed" because
				# the same button also carried a second onclick. This one does
				# nothing else, so a missing marker means the call itself.
				button = {
					size = { 120 28 }
					using = default_button
					text = "BC_PROBE_MARK_BUTTON"
					tooltip = "BC_PROBE_MARK_BUTTON_TOOLTIP"
					onclick = "[GetScriptedGui('bc_probe_click_sgui').Execute(GuiScope.SetRoot(Country.MakeScope).End)]"
				}
			}

			# All three counters share the state name 'bc_fire', so one button
			# press triggers all of them and the three counts are directly
			# comparable within a single pass.
			widget = {
				size = { 1 1 }

				### A -- every valid option, unguarded. Expect: one line per
				# valid state, per click, and nothing without a click.
				flowcontainer = {
					direction = vertical
					datamodel = "[MapListPanel.AccessValidOptions]"

					item = {
						widget = {
							size = { 1 1 }
							datacontext = "[MapListOption.AccessBuildingData.AccessState]"

							state = {
								name = bc_fire
								on_start = "[GetScriptedGui('bc_probe_state_sgui').Execute(GuiScope.SetRoot(State.MakeScope).End)]"
							}
						}
					}
				}

				### B -- guarded by the same condition vanilla's + button uses.
				# Fewer than A means the valid list contains options the player
				# may not click, so the guard is load-bearing.
				flowcontainer = {
					direction = vertical
					datamodel = "[MapListPanel.AccessValidOptions]"

					item = {
						widget = {
							size = { 1 1 }
							visible = "[MapListOption.CanClick]"
							datacontext = "[MapListOption.AccessBuildingData.AccessState]"

							state = {
								name = bc_fire
								on_start = "[GetScriptedGui('bc_probe_clickable_sgui').Execute(GuiScope.SetRoot(State.MakeScope).End)]"
							}
						}
					}
				}

				### C -- the control, hard-coded invisible. `visible` already
				# failed to gate creation; this asks the narrower question of
				# whether it gates a hand-triggered state. Zero means B's guard
				# works and the design is viable. Non-zero means no GUI-side
				# guard exists and we go to the script route.
				flowcontainer = {
					direction = vertical
					datamodel = "[MapListPanel.AccessValidOptions]"

					item = {
						widget = {
							size = { 1 1 }
							visible = no
							datacontext = "[MapListOption.AccessBuildingData.AccessState]"

							state = {
								name = bc_fire
								on_start = "[GetScriptedGui('bc_probe_hidden_sgui').Execute(GuiScope.SetRoot(State.MakeScope).End)]"
							}
						}
					}
				}
			}
			### BC PROBE -- end ######################################

			construction_headers_condensed = {
				visible = "[Not(GetVariableSystem.Exists('construction_list_toggle_full_or_condensed'))]"
			}
			construction_headers_full = {
				visible = "[GetVariableSystem.Exists('construction_list_toggle_full_or_condensed')]"
			}
		}

		blockoverride "item" {
			item = {
				container = {
					min_width = @bc2_panel_width

					construction_interaction_item_condensed = {
						visible = "[Not(GetVariableSystem.Exists('construction_list_toggle_full_or_condensed'))]"
					}

					construction_interaction_item_full = {
						visible = "[GetVariableSystem.Exists('construction_list_toggle_full_or_condensed')]"
					}
				}
			}
		}
	}
}
