# Local Claude Code settings (attribution config etc.) -- not part of the
# mod itself. .claude/skills/ is tracked deliberately (2026-09-08): those
# wrap this repo's own tools/*.py scripts and belong with the rest of the
# dev tooling, not treated as personal/local config.
.claude/settings.json

# Python bytecode from tools/ -- build artefacts, never content.
__pycache__/

# OS cache/metadata files -- never intentional content.
.DS_Store
Thumbs.db
desktop.ini

# Notification-census manifest written by `tools/build_census_mod.py --manifest-only`.
# A build artefact describing a throwaway measurement mod, regenerated on demand.
# The real build (and its own copy of this manifest) lives outside the repo.
tools/census_manifest.json
