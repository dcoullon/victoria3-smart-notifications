					custom_tooltip_textbox = { raw_text = "Breaks even up to a route multiplier of x[Divide_CFixedPoint(Multiply_CFixedPoint(Subtract_CFixedPoint(Add_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketPrice, Multiply_CFixedPoint(ArticleDraft.GetGoods.GetBasePrice, Subtract_CFixedPoint(Multiply_CFixedPoint('(CFixedPoint)0.75', Max_CFixedPoint(Min_CFixedPoint(Divide_CFixedPoint(Subtract_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, Add_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders, ArticleDraft.GetQuantity)), Min_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, Add_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders, ArticleDraft.GetQuantity))), '(CFixedPoint)1'), '(CFixedPoint)-1')), Multiply_CFixedPoint('(CFixedPoint)0.75', Max_CFixedPoint(Min_CFixedPoint(Divide_CFixedPoint(Subtract_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders), Min_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders)), '(CFixedPoint)1'), '(CFixedPoint)-1'))))), Add_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketPrice, Multiply_CFixedPoint(ArticleDraft.GetGoods.GetBasePrice, Subtract_CFixedPoint(Multiply_CFixedPoint('(CFixedPoint)0.75', Max_CFixedPoint(Min_CFixedPoint(Divide_CFixedPoint(Subtract_CFixedPoint(Add_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetQuantity), ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketSellOrders), Min_CFixedPoint(Add_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetQuantity), ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketSellOrders)), '(CFixedPoint)1'), '(CFixedPoint)-1')), Multiply_CFixedPoint('(CFixedPoint)0.75', Max_CFixedPoint(Min_CFixedPoint(Divide_CFixedPoint(Subtract_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketSellOrders), Min_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketSellOrders)), '(CFixedPoint)1'), '(CFixedPoint)-1')))))), ArticleDraft.GetGoods.GetTradedQuantity), GetGoods('merchant_marine').WithMarketContext(GetPlayer.GetMarket.Self).GetMarketPrice)|2] (short routes are x1.00; Lisbon to Persia via Suez is x1.17). Below x1.00 it loses on any sea route." }
				}
				custom_tooltip_textbox = { raw_text = "Not counted: how both markets adjust after the first weeks, and the higher merchant-marine price a new lane causes." }
				custom_tooltip_textbox = { raw_text = "The treaty binds for years. Check before sending." }

				tooltip_divider = {}
				custom_tooltip_textbox = { raw_text = "dev Y1 home buy/sell=[ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketBuyOrders|0]/[ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketSellOrders|0] rule price=[Multiply_CFixedPoint(ArticleDraft.GetGoods.GetBasePrice, Add_CFixedPoint('(CFixedPoint)1', Multiply_CFixedPoint('(CFixedPoint)0.75', Max_CFixedPoint(Min_CFixedPoint(Divide_CFixedPoint(Subtract_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketSellOrders), Min_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketSellOrders)), '(CFixedPoint)1'), '(CFixedPoint)-1'))))|2] actual=[ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketPrice|2] base=[ArticleDraft.GetGoods.GetBasePrice|2]" }
				custom_tooltip_textbox = { raw_text = "dev Y2 partner buy/sell=[ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders|0]/[ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders|0] rule price=[Multiply_CFixedPoint(ArticleDraft.GetGoods.GetBasePrice, Add_CFixedPoint('(CFixedPoint)1', Multiply_CFixedPoint('(CFixedPoint)0.75', Max_CFixedPoint(Min_CFixedPoint(Divide_CFixedPoint(Subtract_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders), Min_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders)), '(CFixedPoint)1'), '(CFixedPoint)-1'))))|2] actual=[ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketPrice|2]" }
				custom_tooltip_textbox = { raw_text = "dev Y3 adjacent=[SelectLocalization(GetScriptedGui('st_markets_adjacent_sgui').IsValid(GuiScope.SetRoot(ArticleDraft.GetFirstOrSource.MakeScope).AddScope('st_other', ArticleDraft.GetSecondOrTarget.MakeScope).End), 'SMART_TRADE_YES', 'SMART_TRADE_NO')] tq=[ArticleDraft.GetGoods.GetTradedQuantity|0]" }
			}
		}
	}

	# Treasury tooltip: one row per treaty with a money effect.
	type SmartTradeTreatiesTooltipWidget = TooltipWidgetType {
		blockoverride "tooltip_content_after" {
			flowcontainer = {
				direction = vertical
				datamodel = "[GetPlayer.GetInForceTreaties]"
				item = {
					flowcontainer = {
						direction = vertical
						visible = "[Or(GreaterThan_CFixedPoint(Abs_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_margin')), '(CFixedPoint)0'), GreaterThan_CFixedPoint(Abs_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_money')), '(CFixedPoint)0'))]"
						custom_tooltip_textbox = {
							visible = "[GreaterThan_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_has_lane'), '(CFixedPoint)0')]"
							raw_text = "[Treaty.GetNameNoFormatting]: trade @money![Subtract_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_margin'), Multiply_CFixedPoint(Treaty.GetShippingLaneOf(GetPlayer.Self).GetMerchantMarineDemandRaw, GetGoods('merchant_marine').WithMarketContext(GetPlayer.GetMarket.Self).GetMarketPrice))|D+=], money @money![Treaty.MakeScope.ScriptValue('st_treaty_money')|D+=]"
						}
						custom_tooltip_textbox = {
							visible = "[Not(GreaterThan_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_has_lane'), '(CFixedPoint)0'))]"
							raw_text = "[Treaty.GetNameNoFormatting]: trade @money![Treaty.MakeScope.ScriptValue('st_treaty_margin')|D+=], money @money![Treaty.MakeScope.ScriptValue('st_treaty_money')|D+=]"
						}
					}
				}
			}
		}
	}
}

# Registers the treasury tooltip widget under the name the loc line uses
# (vanilla does the same for its own in gui/cooltip.gui).
SmartTradeTreatiesTooltipWidget = {
	name = "SmartTradeTreatiesTooltip"
}

types treaty_panel_types {
	# Vanilla body unchanged (gui/treaty_panel.gui:1213-1241); added: the net
	# chip for goods the player sends, and the breakdown tooltip.
	type goods_transfer_article = widget {
		visible = "[Article.HasType('goods_transfer')]"
		size = { 145 40 }
		using = tooltip_ne

		tooltipwidget = {
			smart_trade_article_tooltip = {}
		}

		flowcontainer = {
			datacontext = "[Article.GetGoods]"
			parentanchor = vcenter
			spacing = 2

			icon = {
				parentanchor = vcenter
				size = { 30 30 }
				texture = "[Goods.GetTexture]"
			}

			textbox = {
				parentanchor = vcenter
				autoresize = yes
				align = nobaseline
				max_width = 130
				using = elide_fontsize_min
				text = "TREATY_SELECTED_ARTICLE_AMOUNT"

				block "text_format" {
					default_format = "#black"
				}
			}
		}

		textbox = {
			visible = "[And(Article.GetSourceCountry.IsLocalPlayer, GreaterThan_CFixedPoint(Article.MakeScope.ScriptValue('st_article_has_lane'), '(CFixedPoint)0'))]"
			parentanchor = top|right
			autoresize = yes
			raw_text = "@money![Subtract_CFixedPoint(Multiply_CFixedPoint(Article.GetQuantity, Subtract_CFixedPoint(Article.GetGoods.WithMarketContext(Article.GetTargetCountry.GetMarket.Self).GetMarketPrice, Article.GetGoods.WithMarketContext(Article.GetSourceCountry.GetMarket.Self).GetMarketPrice)), Multiply_CFixedPoint(Divide_CFixedPoint(Article.MakeScope.ScriptValue('st_article_lane_units'), Article.GetTreaty.MakeScope.ScriptValue('st_treaty_lane_units')), Multiply_CFixedPoint(Article.GetShippingLane.GetMerchantMarineDemandRaw, GetGoods('merchant_marine').WithMarketContext(GetPlayer.GetMarket.Self).GetMarketPrice)))|D+=]"
		}
		textbox = {
			visible = "[And(Article.GetSourceCountry.IsLocalPlayer, Not(GreaterThan_CFixedPoint(Article.MakeScope.ScriptValue('st_article_has_lane'), '(CFixedPoint)0')))]"
			parentanchor = top|right
			autoresize = yes
			raw_text = "@money![Multiply_CFixedPoint(Article.GetQuantity, Subtract_CFixedPoint(Article.GetGoods.WithMarketContext(Article.GetTargetCountry.GetMarket.Self).GetMarketPrice, Article.GetGoods.WithMarketContext(Article.GetSourceCountry.GetMarket.Self).GetMarketPrice))|D+=]"
		}
	}

	# Vanilla body unchanged (gui/treaty_panel.gui:756-807); added: the
	# treaty's net to the player, beside the player's influence cost, on the
	# signed-treaty panel only (Treaty context).
	type total_influence_cost = hbox {
		minimumsize = { 64 -1 }
		using = tooltip_ne
		tooltip = "TREATY_TOTAL_INFLUENCE_COST"

		block "expand_before" {}

		hbox = {
			margin = { 0 2 }
			spacing = 2

			block "horizontal_margins" {
				margin_left = 2
				margin_right = 5
			}

			background = {
				using = entry_bg_simple_solid

				block "background_alpha" {
					alpha = 0.4
				}

				block "background_margin" {
					margin_left = 10
				}
			}

			### INFLUENCE ICON
			icon = {
				size = { 25 25 }
				texture = "gfx/interface/icons/topbar/influence_icon.dds"
			}

			### INFLUENCE COST
			textbox = {
				autoresize = yes
				align = nobaseline
				using = elide_fontsize_min
				max_width = 35

				block "text_minimumsize" {}

				block "influence_number" {
					raw_text = "#v [Treaty.GetCost(Country.Self)|0]#!"
				}
			}
		}

		### SMART TRADE: treaty net to the player
		textbox = {
			visible = "[And(And(PdxGuiWidget.HasContext('Treaty'), Country.IsLocalPlayer), GreaterThan_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_has_lane'), '(CFixedPoint)0'))]"
			autoresize = yes
			align = nobaseline
			margin_left = 6
			raw_text = "@money![Add_CFixedPoint(Subtract_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_margin'), Multiply_CFixedPoint(Treaty.GetShippingLaneOf(GetPlayer.Self).GetMerchantMarineDemandRaw, GetGoods('merchant_marine').WithMarketContext(GetPlayer.GetMarket.Self).GetMarketPrice)), Treaty.MakeScope.ScriptValue('st_treaty_money'))|D+=]/wk"
			tooltipwidget = { smart_trade_treaty_tooltip = {} }
		}
		textbox = {
			visible = "[And(And(PdxGuiWidget.HasContext('Treaty'), Country.IsLocalPlayer), Not(GreaterThan_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_has_lane'), '(CFixedPoint)0')))]"
			autoresize = yes
			align = nobaseline
			margin_left = 6
			raw_text = "@money![Add_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_margin'), Treaty.MakeScope.ScriptValue('st_treaty_money'))|D+=]/wk"
			tooltipwidget = { smart_trade_treaty_tooltip = {} }
		}

		block "expand_after" {
			expand = {}
		}
	}
}

types treaty_draft_panel_types {
	# Vanilla's cell (gui/treaty_draft_panel.gui:884-892) wrapped in a vbox so
	# the predicted net can sit under it. The cell's Country is the article's
	# maintenance payer, which for a goods transfer is the sender.
	type article_draft_influence_cost = vbox {
		layoutpolicy_horizontal = expanding

		article_influence_cost = {
			blockoverride "influence_cost_alpha" {
				alpha = "[TransparentIfZero(ArticleDraft.GetCostFor(Country.Self))]"
			}

			blockoverride "influence_cost_text" {
				raw_text = "#v [ArticleDraft.GetCostFor(Country.Self)|0]#!"
			}
		}

		textbox = {
			visible = "[And(And(ArticleDraft.HasType('goods_transfer'), Country.IsLocalPlayer), GetScriptedGui('st_markets_adjacent_sgui').IsValid(GuiScope.SetRoot(ArticleDraft.GetFirstOrSource.MakeScope).AddScope('st_other', ArticleDraft.GetSecondOrTarget.MakeScope).End))]"
			autoresize = yes
			align = right|nobaseline
			raw_text = "@money![Multiply_CFixedPoint(ArticleDraft.GetQuantity, Subtract_CFixedPoint(Add_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketPrice, Multiply_CFixedPoint(ArticleDraft.GetGoods.GetBasePrice, Subtract_CFixedPoint(Multiply_CFixedPoint('(CFixedPoint)0.75', Max_CFixedPoint(Min_CFixedPoint(Divide_CFixedPoint(Subtract_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, Add_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders, ArticleDraft.GetQuantity)), Min_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, Add_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders, ArticleDraft.GetQuantity))), '(CFixedPoint)1'), '(CFixedPoint)-1')), Multiply_CFixedPoint('(CFixedPoint)0.75', Max_CFixedPoint(Min_CFixedPoint(Divide_CFixedPoint(Subtract_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders), Min_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders)), '(CFixedPoint)1'), '(CFixedPoint)-1'))))), Add_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketPrice, Multiply_CFixedPoint(ArticleDraft.GetGoods.GetBasePrice, Subtract_CFixedPoint(Multiply_CFixedPoint('(CFixedPoint)0.75', Max_CFixedPoint(Min_CFixedPoint(Divide_CFixedPoint(Subtract_CFixedPoint(Add_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetQuantity), ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketSellOrders), Min_CFixedPoint(Add_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetQuantity), ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketSellOrders)), '(CFixedPoint)1'), '(CFixedPoint)-1')), Multiply_CFixedPoint('(CFixedPoint)0.75', Max_CFixedPoint(Min_CFixedPoint(Divide_CFixedPoint(Subtract_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketSellOrders), Min_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketSellOrders)), '(CFixedPoint)1'), '(CFixedPoint)-1')))))))|D+=]/wk"
			tooltipwidget = { smart_trade_draft_tooltip = {} }
		}
		textbox = {
			visible = "[And(And(ArticleDraft.HasType('goods_transfer'), Country.IsLocalPlayer), Not(GetScriptedGui('st_markets_adjacent_sgui').IsValid(GuiScope.SetRoot(ArticleDraft.GetFirstOrSource.MakeScope).AddScope('st_other', ArticleDraft.GetSecondOrTarget.MakeScope).End)))]"
