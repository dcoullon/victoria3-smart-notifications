			align = right|nobaseline
			using = fontsize_small
			margin_bottom = 4
			raw_text = "Net @money![Multiply_CFixedPoint(ArticleDraft.GetQuantity, Subtract_CFixedPoint(Add_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketPrice, Multiply_CFixedPoint(ArticleDraft.GetGoods.GetBasePrice, Subtract_CFixedPoint(Multiply_CFixedPoint('(CFixedPoint)0.75', Max_CFixedPoint(Min_CFixedPoint(Divide_CFixedPoint(Subtract_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, Add_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders, ArticleDraft.GetQuantity)), Max_CFixedPoint(Min_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, Add_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders, ArticleDraft.GetQuantity)), '(CFixedPoint)0.01')), '(CFixedPoint)1'), '(CFixedPoint)-1')), Multiply_CFixedPoint('(CFixedPoint)0.75', Max_CFixedPoint(Min_CFixedPoint(Divide_CFixedPoint(Subtract_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders), Max_CFixedPoint(Min_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders), '(CFixedPoint)0.01')), '(CFixedPoint)1'), '(CFixedPoint)-1'))))), Add_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketPrice, Multiply_CFixedPoint(ArticleDraft.GetGoods.GetBasePrice, Subtract_CFixedPoint(Multiply_CFixedPoint('(CFixedPoint)0.75', Max_CFixedPoint(Min_CFixedPoint(Divide_CFixedPoint(Subtract_CFixedPoint(Add_CFixedPoint(ArticleDraf