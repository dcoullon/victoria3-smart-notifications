types treaty_panel_types {
	# Vanilla body (gui/treaty_panel.gui:1213-1241) with the amount moved into
	# a vertical flow so the net can sit on its own line under it.
	type goods_transfer_article = widget {
		visible = "[Article.HasType('goods_transfer')]"
		size = { 145 40 }
		using = tooltip_ne

		tooltipwidget = {
			smart_trade_article_tooltip = {}
		}

		flowcontainer = {
			datacontext = "[Article.GetGoods]"
			parentanchor = vcenter
			spacing = 2

			icon = {
				parentanchor = vcenter
				size = { 30 30 }
				texture = "[Goods.GetTexture]"
			}

			flowcontainer = {
				direction = vertical
				parentanchor = vcenter

				textbox = {
					autoresize = yes
					align = nobaseline
					max_width = 110
					using = elide_fontsize_min
					text = "TREATY_SELECTED_ARTICLE_AMOUNT"

					block "text_format" {
						default_format = "#black"
					}
				}

				textbox = {
					visible = "[And(Article.GetSourceCountry.IsLocalPlayer, GreaterThan_CFixedPoint(Article.MakeScope.ScriptValue('st_article_has_lane'), '(CFixedPoint)0'))]"
					autoresize = yes
					align = nobaseline
					using = fontsize_small
					margin_top = -3
					raw_text = "Net @money![Subtract_CFixedPoint(Multiply_CFixedPoint(Article.GetQuantity, Subtract_CFixedPoint(Article.GetGoods.WithMarketContext(Article.GetTargetCountry.GetMarket.Self).GetMarketPrice, Article.GetGoods.WithMarketContext(Article.GetSourceCountry.GetMarket.Self).GetMarketPrice)), Multiply_CFixedPoint(Divide_CFixedPoint(Article.MakeScope.ScriptValue('st_article_lane_units'), Article.GetTreaty.MakeScope.ScriptValue('st_treaty_lane_units')), Multiply_CFixedPoint(Article.GetShippingLane.GetMerchantMarineDemandRaw, GetGoods('merchant_marine').WithMarketContext(GetPlayer.GetMarket.Self).GetMarketPrice)))|D+=]"
				}
				textbox = {
					visible = "[And(Article.GetSourceCountry.IsLocalPlayer, Not(GreaterThan_CFixedPoint(Article.MakeScope.ScriptValue('st_article_has_lane'), '(CFixedPoint)0')))]"
					autoresize = yes
					align = nobaseline
					using = fontsize_small
					margin_top = -3
					raw_text = "Net @money![Multiply_CFixedPoint(Article.GetQuantity, Subtract_CFixedPoint(Article.GetGoods.WithMarketContext(Article.GetTargetCountry.GetMarket.Self).GetMarketPrice, Article.GetGoods.WithMarketContext(Article.GetSourceCountry.GetMarket.Self).GetMarketPrice))|D+=]"
				}
			}
		}
	}

	# Vanilla body (gui/treaty_panel.gui:756-807) with the influence chip put
	# in a vertical flow so the treaty's net sits under it on the signed-treaty
	# panel (Treaty context) instead of pushing into the header's middle box.
	type total_influence_cost = hbox {
		minimumsize = { 64 -1 }
		using = tooltip_ne
		tooltip = "TREATY_TOTAL_INFLUENCE_COST"

		block "expand_before" {}

		vbox = {
			hbox = {
				margin = { 0 2 }
				spacing = 2

				block "horizontal_margins" {
					margin_left = 2
					margin_right = 5
				}

				background = {
					using = entry_bg_simple_solid

					block "background_alpha" {
						alpha = 0.4
					}

					block "background_margin" {
						margin_left = 10
					}
				}

				### INFLUENCE ICON
				icon = {
					size = { 25 25 }
					texture = "gfx/interface/icons/topbar/influence_icon.dds"
				}

				### INFLUENCE COST
				textbox = {
					autoresize = yes
					align = nobaseline
					using = elide_fontsize_min
					max_width = 35

					block "text_minimumsize" {}

					block "influence_number" {
						raw_text = "#v [Treaty.GetCost(Country.Self)|0]#!"
					}
				}
			}

			### SMART TRADE: the treaty's net to the player
			textbox = {
				visible = "[And(And(PdxGuiWidget.HasContext('Treaty'), Country.IsLocalPlayer), And(Or(GreaterThan_CFixedPoint(Abs_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_margin')), '(CFixedPoint)0'), GreaterThan_CFixedPoint(Abs_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_money')), '(CFixedPoint)0')), GreaterThan_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_has_lane'), '(CFixedPoint)0')))]"
				autoresize = yes
				align = nobaseline
				using = fontsize_small
				margin_top = -3
				raw_text = "Net @money![Add_CFixedPoint(Subtract_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_margin'), Multiply_CFixedPoint(Treaty.GetShippingLaneOf(GetPlayer.Self).GetMerchantMarineDemandRaw, GetGoods('merchant_marine').WithMarketContext(GetPlayer.GetMarket.Self).GetMarketPrice)), Treaty.MakeScope.ScriptValue('st_treaty_money'))|D+=]/wk"
				tooltipwidget = { smart_trade_treaty_tooltip = {} }
			}
			textbox = {
				visible = "[And(And(PdxGuiWidget.HasContext('Treaty'), Country.IsLocalPlayer), And(Or(GreaterThan_CFixedPoint(Abs_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_margin')), '(CFixedPoint)0'), GreaterThan_CFixedPoint(Abs_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_money')), '(CFixedPoint)0')), Not(GreaterThan_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_has_lane'), '(CFixedPoint)0'))))]"
				autoresize = yes
				align = nobaseline
				using = fontsize_small
				margin_top = -3
				raw_text = "Net @money![Add_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_margin'), Treaty.MakeScope.ScriptValue('st_treaty_money'))|D+=]/wk"
				tooltipwidget = { smart_trade_treaty_tooltip = {} }
			}

			### SMART TRADE, draft only: the partner's market borders ours
			textbox = {
				visible = "[And(And(PdxGuiWidget.HasContext('TreatyDraft'), Not(Country.IsLocalPlayer)), GetScriptedGui('st_markets_adjacent_sgui').IsValid(GuiScope.SetRoot(Country.MakeScope).AddScope('st_other', TreatyDraft.GetOtherCountry(Country.Self).MakeScope).End))]"
				autoresize = yes
				align = nobaseline
				using = fontsize_small
				margin_top = -3
				raw_text = "No shipping"
				tooltip = "SMART_TRADE_OVERLAND_TT"
			}
		}

		block "expand_after" {
			expand = {}
		}
	}
}

types treaty_draft_panel_types {
	# Vanilla's cell (gui/treaty_draft_panel.gui:884-892) wrapped in a vbox so
	# the predicted net can sit under it. The cell's Country is the article's
	# maintenance payer, which for a goods transfer is the sender.
	type article_draft_influence_cost = vbox {
		layoutpolicy_horizontal = expanding

		article_influence_cost = {
			blockoverride "influence_cost_alpha" {
				alpha = "[TransparentIfZero(ArticleDraft.GetCostFor(Country.Self))]"
