	type smart_trade_article_tooltip = RegularTooltip {
		blockoverride "tooltip_content" {
			flowcontainer = {
				direction = vertical
				minimumsize = { 380 -1 }

				custom_tooltip_textbox = { raw_text = "#header [Article.GetGoods.GetName], [Article.GetQuantity|0] a week to [Article.GetTargetCountry.GetNameNoFormatting]#!" }
				custom_tooltip_textbox = {
					visible = "[Not(Article.GetSourceCountry.IsLocalPlayer)]"
					raw_text = "Paid for by [Article.GetSourceCountry.GetNameNoFormatting]. No cost to you."
				}
				flowcontainer = {
					direction = vertical
					visible = "[Article.GetSourceCountry.IsLocalPlayer]"
					custom_tooltip_textbox = { raw_text = "Sale: @money![Multiply_CFixedPoint(Article.GetQuantity, Article.GetGoods.WithMarketContext(Article.GetTargetCountry.GetMarket.Self).GetMarketPrice)|D+=] ([Article.GetQuantity|0] x @money![Article.GetGoods.WithMarketContext(Article.GetTargetCountry.GetMarket.Self).GetMarketPrice|2])" }
