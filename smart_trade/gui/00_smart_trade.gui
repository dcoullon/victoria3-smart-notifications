							tooltipwidget = { smart_trade_card_tooltip = {} }
						}
						treaty_draft_input_acceptance_button_icon = {
							visible = "[And(Not(PdxGuiWidget.HasContext('WarGoalDraft')), TreatyDraft.GetRightCountry.IsAI)]"
							parentanchor = right
							position = { -5 5 }
						}
					}

					blockoverride "default_button" {
						using = default_button
					}
				}

				widget = {
					visible = "[ObjectsEqual(ArticleDraft.GetGoods.Self, Goods.Self)]"
					size = { -1 120 }
					min_width = 100
					using = tooltip_ne

					tooltipwidget = {
						FancyTooltip_Goods = {
							blockoverride "goods_interactions" {}
							blockoverride "goods_trend" {}

							blockoverride "goods_name" {
								text = "GOODS_NAME_ARTICLE_SELECTED"
							}

							blockoverride "tooltip_content_before_before" {
								flowcontainer = {
									visible = "[Not(PdxGuiWidget.HasContext('WarGoalDraft'))]"
									spacing = 5
									tooltip = "[ArticleDraft.GetAcceptanceBreakdown(TreatyDraft.GetRightCountry.Self)]"

									treaty_draft_input_acceptance_icon = {}

									custom_tooltip_textbox = {
										parentanchor = vcenter
										max_width = 500
										text = "ARTICLE_DRAFT_ACCEPTANCE_WITH_LABEL"
									}
								}
							}

							### The below two blockoverrides is to always show the local player's market on the left
							blockoverride "state_price_card" {
								container = {
									visible = "[Not(PdxGuiWidget.HasContext('WarGoalDraft'))]"

									market_price_card = {
										visible = "[Country.IsLocalPlayer]"
									}

									market_price_card = {
										visible = "[Not(Country.IsLocalPlayer)]"
										datacontext = "[Goods.WithMarketContext(TreatyDraft.GetOtherCountry(Country.Self).GetMarket.Self)]"
									}
								}

								container = {
									visible = "[PdxGuiWidget.HasContext('WarGoalDraft')]"

									market_price_card = {
										datacontext = "[Goods.WithMarketContext(WarGoalDraft.GetHolder.GetMarket.Self)]"
									}
								}
							}

							blockoverride "market_price_card" {
								container = {
									visible = "[Not(PdxGuiWidget.HasContext('WarGoalDraft'))]"

									market_price_card = {
										visible = "[Not(Country.IsLocalPlayer)]"
									}

									market_price_card = {
										visible = "[Country.IsLocalPlayer]"
										datacontext = "[Goods.WithMarketContext(TreatyDraft.GetOtherCountry(Country.Self).GetMarket.Self)]"
									}
								}

								container = {
									visible = "[PdxGuiWidget.HasContext('WarGoalDraft')]"

									market_price_card = {
										datacontext = "[Goods.WithMarketContext(WarGoalDraft.GetTarget.GetMarket.Self)]"
									}
								}
							}
						}
					}

					state = {
						name = _show
						alpha = 1
						duration = 0.1
						on_start = "[PdxGuiWidget.FindChild('goods_icon').InterruptThenTriggerAnimation('hide','show')]"
					}

					state = {
						name = _hide
						alpha = 0
						duration = 0.1
						using = Animation_Curve_Default
						on_start = "[PdxGuiWidget.FindChild('goods_icon').InterruptThenTriggerAnimation('show','hide')]"
					}


					background = {
						using = paper_bg
					}

					widget = {
						name = "goods_icon"
						parentanchor = hcenter
						size = { 50 50 }
						position = { 0 5 }

						state = {
							name = show
							size = { 60 60 }
							duration = 0.2
							using = Animation_Curve_Default
						}

						state = {
							name = hide
							size = { 50 50 }
							duration = 0.2
							using = Animation_Curve_Default
						}

						icon = {
							parentanchor = center
							size = { 200% 200% }
							using = rotate_glow_animation_02
						}

						icon = {
							size = { 100% 100% }
							parentanchor = center
							texture = "[Goods.GetTexture]"
						}
					}

					textbox = {
						align = hcenter|nobaseline
						position = { 0 -16 }
						size = { 100% 50 }
						parentanchor = hcenter|bottom
						using = fontsize_small
						multiline = yes
						margin_left = 5
						margin_right = 5
						text = "[Goods.GetNameNoFormatting]"
					}

					widget = {
						size = { 100% 20 }
						parentanchor = bottom
						position = { 0 -5 }

						article_market_goods_numbers = {
								visible = "[Not(PdxGuiWidget.HasContext('WarGoalDraft'))]"
							}

						article_market_goods_numbers = {
							visible = "[PdxGuiWidget.HasContext('WarGoalDraft')]"

							blockoverride "left_market_number" {
								article_market_goods_balance_number = {
									datacontext = "[Goods.WithMarketContext(WarGoalDraft.GetHolder.GetMarket.Self)]"
								}
							}

							blockoverride "right_market_number" {
								article_market_goods_balance_number = {
									datacontext = "[Goods.WithMarketContext(WarGoalDraft.GetTarget.GetMarket.Self)]"
								}
							}
						}
					}

					### ACCEPTANCE ICON - GOODS - SELECTED
					treaty_draft_input_acceptance_icon = {
						visible = "[Not(PdxGuiWidget.HasContext('WarGoalDraft'))]"
						parentanchor = right
						position = { -5 5 }
					}

					icon = {
						using = highlighted_square_selection
					}
				}
			}
		}
	}

	# Vanilla selected_goods_and_amount, copied verbatim at generation time from
	# gui/right_click_menu.gui:11958-12232, with Smart Trade insertions.
	type selected_goods_and_amount = widget {
		parentanchor = hcenter
		size = { 400 70 }

		container = {
			parentanchor = vcenter
			minimumsize = { 150 -1 }

			flowcontainer = {
				parentanchor = center
				spacing = 5

				icon = {
					visible = "[ArticleDraft.HasInputValue('goods')]"
					parentanchor = vcenter
					size = { 40 40 }
					texture = "[ArticleDraft.GetGoods.GetTexture]"
				}

				textbox = {
					visible = "[ArticleDraft.HasInputValue('goods')]"
					parentanchor = vcenter
					align = nobaseline
					autoresize = yes
					using = elide_fontsize_min
					max_width = 100
					multiline = yes
					text = "[ArticleDraft.GetGoods.GetNameNoIcon]"
				}

				textbox = {
					visible = "[Not(ArticleDraft.HasInputValue('goods'))]"
					parentanchor = vcenter
					align = nobaseline
					autoresize = yes
					using = elide_fontsize_min
					max_width = 145
					text = "SELECT_A_GOOD"
				}
			}
		}

		flowcontainer = {
			direction = vertical
			parentanchor = vcenter|right
			spacing = 5

			### QUANTITY SLIDERS DIVIDED INTO 2 SCROLLBARS FOR THE TOOLTIPS' SAKE
			flowcontainer = {
				visible = "[ArticleDraft.HasInputValue('goods')]"
				parentanchor = hcenter

				flowcontainer = {
					visible = "[NotEqualTo_int32(ArticleDraft.GetMinValidQuantity, ArticleDraft.GetMaxValidQuantity)]"
					margin_top = 5
					tooltip = "ARTICLE_DRAFT_GOODS_QUANTITY_SLIDER_TOOLTIP_ENABLED"

					scrollbar = {
						direction = horizontal
						size = { 240 20 }
						value = "[ArticleDraft.GetQuantity]"
						enabled = "[NotEqualTo_int32(ArticleDraft.GetMinValidQuantity, ArticleDraft.GetMaxValidQuantity)]"

						min = "[ArticleDraft.GetMinValidQuantity]"
						max = "[ArticleDraft.GetMaxValidQuantity]"
						step = 1.0
						wheelstep = 1.0

						onvaluechanged = "[ArticleDraft.OnQuantityChangedSlider]"

						track = {
							using = SettingsValueTrack
						}

						slider = {
							using = SettingsValueSlider
						}

						dec_button = {
							using = SettingsValueDecButton
						}

						inc_button = {
							using = SettingsValueIncButton
						}
					}
				}

				flowcontainer = {
					visible = "[EqualTo_int32(ArticleDraft.GetMinValidQuantity, ArticleDraft.GetMaxValidQuantity)]"
					margin_top = 5
					tooltip = "ARTICLE_DRAFT_GOODS_QUANTITY_SLIDER_TOOLTIP_DISABLED"

					scrollbar = {
						direction = horizontal
						size = { 240 20 }
						value = "[ArticleDraft.GetQuantity]"
						enabled = "[NotEqualTo_int32(ArticleDraft.GetMinValidQuantity, ArticleDraft.GetMaxValidQuantity)]"

						min = "[ArticleDraft.GetMinValidQuantity]"
						max = "[ArticleDraft.GetMaxValidQuantity]"
						step = 1.0
						wheelstep = 1.0

						onvaluechanged = "[ArticleDraft.OnQuantityChangedSlider]"

						track = {
							using = SettingsValueTrack
						}

						slider = {
							using = SettingsValueSlider
						}

						dec_button = {
							using = SettingsValueDecButton
						}

						inc_button = {
							using = SettingsValueIncButton
						}
					}
				}
			}

			### QUANTITY SLIDER WITHOUT FUNCTION CALLS IF NO GOOD HAS BEEN SELECTED
			flowcontainer = {
				visible = "[Not(ArticleDraft.HasInputValue('goods'))]"
				parentanchor = hcenter
				margin_top = 5

				scrollbar = {
					enabled = no
					direction = horizontal
					size = { 240 20 }
					value = 0

					min = 0.0
					max = 1.0
					step = 1.0
					wheelstep = 1.0

					track = {
						using = SettingsValueTrack
					}

					slider = {
						using = SettingsValueSlider
					}

					dec_button = {
						using = SettingsValueDecButton
					}

					inc_button = {
						using = SettingsValueIncButton
					}
				}
			}

			flowcontainer = {
				parentanchor = hcenter

				# Write the amount - Goods is selected - Divided in two due to the tooltips
				flowcontainer = {
					visible = "[ArticleDraft.HasInputValue('goods')]"

					editbox = {
						visible = "[NotEqualTo_int32(ArticleDraft.GetMinValidQuantity, ArticleDraft.GetMaxValidQuantity)]"
						name = "treaty_amount_edit_1"
						tooltip = "ARTICLE_DRAFT_GOODS_QUANTITY_SLIDER_TOOLTIP_ENABLED"
						parentanchor = vcenter
						maxcharacters = 30
						size = { 150 40 }
						alwaystransparent = no
						focuspolicy = click
						focus_on_visible = no
						align = nobaseline
						margin_left = 10
						enabled = "[NotEqualTo_int32(ArticleDraft.GetMinValidQuantity, ArticleDraft.GetMaxValidQuantity)]"

						background = {
							using = text_edit_bg
						}

						text = "[ArticleDraft.GetQuantity]"
						ontextchanged = "[ArticleDraft.OnQuantityChanged]"
						text_validator = "[ArticleDraft.GetQuantityValidator]"

						textbox = {
							parentanchor = right|vcenter
							position = { -10 0 }
							align = nobaseline
							autoresize = yes
							using = elide_fontsize_min
							max_width = 70
							raw_text = "[ArticleDraft.GetQuantityPercentage|0%]"
						}
					}

					editbox = {
						visible = "[EqualTo_int32(ArticleDraft.GetMinValidQuantity, ArticleDraft.GetMaxValidQuantity)]"
						name = "treaty_amount_edit_2"
						tooltip = "ARTICLE_DRAFT_GOODS_QUANTITY_SLIDER_TOOLTIP_DISABLED"
						parentanchor = vcenter
						maxcharacters = 30
						size = { 150 40 }
						alwaystransparent = no
						focuspolicy = click
						focus_on_visible = no
						align = nobaseline
						margin_left = 10
						enabled = "[NotEqualTo_int32(ArticleDraft.GetMinValidQuantity, ArticleDraft.GetMaxValidQuantity)]"

						background = {
							using = text_edit_bg
						}

						text = "[ArticleDraft.GetQuantity]"
						ontextchanged = "[ArticleDraft.OnQuantityChanged]"
						text_validator = "[ArticleDraft.GetQuantityValidator]"

						textbox = {
							parentanchor = right|vcenter
							position = { -10 0 }
							align = nobaseline
							autoresize = yes
							using = elide_fontsize_min
							max_width = 70
							raw_text = "[ArticleDraft.GetQuantityPercentage|0%]"
						}
					}
				}

				# Write the amount - Goods is not selected
				editbox = {
					visible = "[Not(ArticleDraft.HasInputValue('goods'))]"
					name = "treaty_amount_edit_no_good"
					enabled = no
					parentanchor = vcenter
					maxcharacters = 30
					size = { 150 40 }
					alwaystransparent = no
					focuspolicy = click
					focus_on_visible = no
					align = nobaseline
					margin_left = 10
					raw_text = "0"

					background = {
						using = text_edit_bg
					}

					textbox = {
						parentanchor = right|vcenter
						position = { -10 0 }
						align = nobaseline
						autoresize = yes
						using = elide_fontsize_min
						max_width = 70
						raw_text = "0%"
					}
				}

				textbox = {
					parentanchor = vcenter
					align = nobaseline
					autoresize = yes
					using = elide_fontsize_min
					max_width = 100
					text = "SLASH_PER_WEEK"
				}
			}

			### SMART TRADE: its own row under the quantity
			flowcontainer = {
				parentanchor = hcenter
				spacing = 4
				margin_top = -2

				### SMART TRADE: live net at the current quantity, then the
				### Best and Max buttons. Shown for every good the player sends,
				### profitable or not (Damien: consistent UX; the player may
				### take a loss on purpose).
				textbox = {
					visible = "[And(And(ArticleDraft.HasType('goods_transfer'), ArticleDraft.GetFirstOrSource.IsLocalPlayer), GetScriptedGui('st_markets_adjacent_sgui').IsValid(GuiScope.SetRoot(ArticleDraft.GetFirstOrSource.MakeScope).AddScope('st_other', ArticleDraft.GetSecondOrTarget.MakeScope).End))]"
					parentanchor = vcenter
					autoresize = yes
					align = nobaseline
					using = fontsize_small
					raw_text = "Net @money![Multiply_CFixedPoint(ArticleDraft.GetQuantity, Subtract_CFixedPoint(Add_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketPrice, Multiply_CFixedPoint(ArticleDraft.GetGoods.GetBasePrice, Subtract_CFixedPoint(Multiply_CFixedPoint('(CFixedPoint)0.75', Max_CFixedPoint(Min_CFixedPoint(Divide_CFixedPoint(Subtract_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, Add_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders, ArticleDraft.GetQuantity)), Max_CFixedPoint(Min_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, Add_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders, ArticleDraft.GetQuantity)), '(CFixedPoint)0.01')), '(CFixedPoint)1'), '(CFixedPoint)-1')), Multiply_CFixedPoint('(CFixedPoint)0.75', Max_CFixedPoint(Min_CFixedPoint(Divide_CFixedPoint(Subtract_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders), Max_CFixedPoint(Min_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders), '(CFixedPoint)0.01')), '(CFixedPoint)1'), '(CFixedPoint)-1'))))), Add_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketPrice, Multiply_CFixedPoint(ArticleDraft.GetGoods.GetBasePrice, Subtract_CFixedPoint(Multiply_CFixedPoint('(CFixedPoint)0.75', Max_CFixedPoint(Min_CFixedPoint(Divide_CFixedPoint(Subtract_CFixedPoint(Add_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetQuantity), ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketSellOrders), Max_CFixedPoint(Min_CFixedPoint(Add_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetQuantity), ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketSellOrders), '(CFixedPoint)0.01')), '(CFixedPoint)1'), '(CFixedPoint)-1')), Multiply_CFixedPoint('(CFixedPoint)0.75', Max_CFixedPoint(Min_CFixedPoint(Divide_CFixedPoint(Subtract_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketSellOrders), Max_CFixedPoint(Min_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketSellOrders), '(CFixedPoint)0.01')), '(CFixedPoint)1'), '(CFixedPoint)-1')))))))|D+=]"
					tooltipwidget = { smart_trade_draft_tooltip = {} }
				}
				textbox = {
					visible = "[And(And(ArticleDraft.HasType('goods_transfer'), ArticleDraft.GetFirstOrSource.IsLocalPlayer), Not(GetScriptedGui('st_markets_adjacent_sgui').IsValid(GuiScope.SetRoot(ArticleDraft.GetFirstOrSource.MakeScope).AddScope('st_other', ArticleDraft.GetSecondOrTarget.MakeScope).End)))]"
					parentanchor = vcenter
					autoresize = yes
					align = nobaseline
					using = fontsize_small
					raw_text = "Net ~@money![Subtract_CFixedPoint(Multiply_CFixedPoint(ArticleDraft.GetQuantity, Subtract_CFixedPoint(Add_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketPrice, Multiply_CFixedPoint(ArticleDraft.GetGoods.GetBasePrice, Subtract_CFixedPoint(Multiply_CFixedPoint('(CFixedPoint)0.75', Max_CFixedPoint(Min_CFixedPoint(Divide_CFixedPoint(Subtract_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, Add_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders, ArticleDraft.GetQuantity)), Max_CFixedPoint(Min_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, Add_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders, ArticleDraft.GetQuantity)), '(CFixedPoint)0.01')), '(CFixedPoint)1'), '(CFixedPoint)-1')), Multiply_CFixedPoint('(CFixedPoint)0.75', Max_CFixedPoint(Min_CFixedPoint(Divide_CFixedPoint(Subtract_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders), Max_CFixedPoint(Min_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders), '(CFixedPoint)0.01')), '(CFixedPoint)1'), '(CFixedPoint)-1'))))), Add_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketPrice, Multiply_CFixedPoint(ArticleDraft.GetGoods.GetBasePrice, Subtract_CFixedPoint(Multiply_CFixedPoint('(CFixedPoint)0.75', Max_CFixedPoint(Min_CFixedPoint(Divide_CFixedPoint(Subtract_CFixedPoint(Add_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetQuantity), ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketSellOrders), Max_CFixedPoint(Min_CFixedPoint(Add_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetQuantity), ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketSellOrders), '(CFixedPoint)0.01')), '(CFixedPoint)1'), '(CFixedPoint)-1')), Multiply_CFixedPoint('(CFixedPoint)0.75', Max_CFixedPoint(Min_CFixedPoint(Divide_CFixedPoint(Subtract_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketSellOrders), Max_CFixedPoint(Min_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketSellOrders), '(CFixedPoint)0.01')), '(CFixedPoint)1'), '(CFixedPoint)-1'))))))), Multiply_CFixedPoint(Multiply_CFixedPoint(Divide_CFixedPoint(ArticleDraft.GetQuantity, ArticleDraft.GetGoods.GetTradedQuantity), GetGoods('merchant_marine').WithMarketContext(GetPlayer.GetMarket.Self).GetMarketPrice), '(CFixedPoint)1.25'))|D+=]"
					tooltipwidget = { smart_trade_draft_tooltip = {} }
				}
				### Goods the player sends: Best, Max, Accept
				smart_trade_best_button = {
					visible = "[And(ArticleDraft.HasType('goods_transfer'), ArticleDraft.GetFirstOrSource.IsLocalPlayer)]"
					parentanchor = vcenter
				}
				smart_trade_best_button = {
					visible = "[And(ArticleDraft.HasType('goods_transfer'), ArticleDraft.GetFirstOrSource.IsLocalPlayer)]"
					parentanchor = vcenter
					blockoverride "action" { onclick = "[ArticleDraft.SetQuantity(Max_CFixedPoint('(CFixedPoint)10', Min_CFixedPoint(Max_CFixedPoint('(CFixedPoint)10', Add_CFixedPoint(Subtract_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders), '(CFixedPoint)10')), Subtract_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketSellOrders, ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketBuyOrders))))]" }
					blockoverride "label" { raw_text = "Max" }
					blockoverride "tip" { tooltip = "SMART_TRADE_MAX_SEND_TT" }
				}
				smart_trade_best_button = {
					visible = "[And(ArticleDraft.HasType('goods_transfer'), ArticleDraft.GetFirstOrSource.IsLocalPlayer)]"
					parentanchor = vcenter
					blockoverride "action" { onclick = "[ArticleDraft.SetQuantity(Max_CFixedPoint('(CFixedPoint)10', Add_CFixedPoint(Subtract_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders), '(CFixedPoint)10')))]" }
					blockoverride "label" { raw_text = "" }
					blockoverride "thumb" { visible = yes }
					blockoverride "tip" { tooltip = "SMART_TRADE_ACCEPT_SEND_TT" }
				}
				### Goods the partner sends: Max, Accept (no treasury effect)
				smart_trade_best_button = {
					visible = "[And(ArticleDraft.HasType('goods_transfer'), ArticleDraft.GetSecondOrTarget.IsLocalPlayer)]"
					parentanchor = vcenter
					blockoverride "action" { onclick = "[ArticleDraft.SetQuantity(Max_CFixedPoint('(CFixedPoint)10', Min_CFixedPoint(Max_CFixedPoint('(CFixedPoint)10', Add_CFixedPoint(Multiply_CFixedPoint('(CFixedPoint)0.3', Subtract_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketSellOrders, ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketBuyOrders)), '(CFixedPoint)10')), Add_CFixedPoint(Subtract_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders), '(CFixedPoint)10'))))]" }
					blockoverride "label" { raw_text = "Max" }
					blockoverride "tip" { tooltip = "SMART_TRADE_MAX_RECV_TT" }
				}
				smart_trade_best_button = {
					visible = "[And(ArticleDraft.HasType('goods_transfer'), ArticleDraft.GetSecondOrTarget.IsLocalPlayer)]"
					parentanchor = vcenter
					blockoverride "action" { onclick = "[ArticleDraft.SetQuantity(Max_CFixedPoint('(CFixedPoint)10', Add_CFixedPoint(Multiply_CFixedPoint('(CFixedPoint)0.3', Subtract_CFixedPoint(ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketSellOrders, ArticleDraft.GetGoods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketBuyOrders)), '(CFixedPoint)10')))]" }
					blockoverride "label" { raw_text = "" }
					blockoverride "thumb" { visible = yes }
					blockoverride "tip" { tooltip = "SMART_TRADE_ACCEPT_RECV_TT" }
				}
			}
		}
	}
}
