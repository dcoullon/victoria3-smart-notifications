	type smart_trade_treaty_tooltip = RegularTooltip {
		blockoverride "tooltip_content" {
			flowcontainer = {
				direction = vertical
				minimumsize = { 420 -1 }

				custom_tooltip_textbox = { raw_text = "#header Smart Trade: what [Treaty.GetNameNoFormatting] does to your treasury#!" }
				custom_tooltip_textbox = { raw_text = "Goods you send, sale minus purchase: @money![Treaty.MakeScope.ScriptValue('st_treaty_margin')|D+=]" }
				custom_tooltip_textbox = {
					visible = "[GreaterThan_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_has_lane'), '(CFixedPoint)0')]"
					raw_text = "Shipping lane: @money![Negate_CFixedPoint(Multiply_CFixedPoint(Treaty.GetShippingLaneOf(GetPlayer.Self).GetMerchantMarineDemandRaw, GetGoods('merchant_marine').WithMarketContext(GetPlayer.GetMarket.Self).GetMarketPrice))|D+=]"
				}
				custom_tooltip_textbox = { raw_text = "Money transfers: @money![Treaty.MakeScope.ScriptValue('st_treaty_money')|D+=]" }
				custom_tooltip_textbox = {
					visible = "[GreaterThan_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_has_lane'), '(CFixedPoint)0')]"
					raw_text = "#bold Net: @money![Add_CFixedPoint(Subtract_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_margin'), Multiply_CFixedPoint(Treaty.GetShippingLaneOf(GetPlayer.Self).GetMerchantMarineDemandRaw, GetGoods('merchant_marine').WithMarketContext(GetPlayer.GetMarket.Self).GetMarketPrice)), Treaty.MakeScope.ScriptValue('st_treaty_money'))|D+=] a week#!"
				}
				custom_tooltip_textbox = {
					visible = "[Not(GreaterThan_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_has_lane'), '(CFixedPoint)0'))]"
					raw_text = "#bold Net: @money![Add_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_margin'), Treaty.MakeScope.ScriptValue('st_treaty_money'))|D+=] a week#!"
				}
				custom_tooltip_textbox = { raw_text = "Hover each goods transfer for its own breakdown." }
			}
		}
	}

