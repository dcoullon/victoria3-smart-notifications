		}
	}
}

types pinnable_outliner_items {
	# Vanilla body (gui/outliner_pinnable_types.gui:366-439); added: the
	# treaty's net to the player at the right, left of the time remaining.
	# Names get a narrower max width only on rows that show a net.
	type outliner_compact_treaty_item = flowcontainer {
		direction = vertical

		tooltipwidget = {
			FancyTooltip_Treaty = {}
		}

		# TREATY NAME & DURATION
		widget = {
			block "size" {
				size = { @st_entry_width 30 }
			}

			background = {
				using = fade_center_colored_black
			}

			### NAME
			flowcontainer = {
				position = { 5 0 }
				parentanchor = vcenter
				spacing = 5

				### LEFT COUNTRY FLAG
				tiny_flag_no_interact = {
					parentanchor = vcenter
					datacontext = "[Treaty.GetLeftCountry]"

					blockoverride "tooltip" {}
				}

				### RIGHT COUNTRY FLAG
				tiny_flag_no_interact = {
					parentanchor = vcenter
					datacontext = "[Treaty.GetRightCountry]"

					blockoverride "tooltip" {}
				}

				textbox = {
					visible = "[And(NotZero(Treaty.GetBindingDaysLeft), Not(Or(GreaterThan_CFixedPoint(Abs_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_margin')), '(CFixedPoint)0'), GreaterThan_CFixedPoint(Abs_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_money')), '(CFixedPoint)0'))))]"
					parentanchor = vcenter
					autoresize = yes
					align = nobaseline
					using = elide_fontsize_min
					max_width = 230
					margin_left = 2
					text = "[Treaty.GetNameNoFormatting]"
				}
				textbox = {
					visible = "[And(NotZero(Treaty.GetBindingDaysLeft), Or(GreaterThan_CFixedPoint(Abs_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_margin')), '(CFixedPoint)0'), GreaterThan_CFixedPoint(Abs_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_money')), '(CFixedPoint)0')))]"
					parentanchor = vcenter
					autoresize = yes
					align = nobaseline
					using = elide_fontsize_min
					max_width = 165
					margin_left = 2
					text = "[Treaty.GetNameNoFormatting]"
				}
				textbox = {
					visible = "[And(Not(NotZero(Treaty.GetBindingDaysLeft)), Not(Or(GreaterThan_CFixedPoint(Abs_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_margin')), '(CFixedPoint)0'), GreaterThan_CFixedPoint(Abs_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_money')), '(CFixedPoint)0'))))]"
					parentanchor = vcenter
					autoresize = yes
					align = nobaseline
					using = elide_fontsize_min
					max_width = 260
					margin_left = 2
					text = "[Treaty.GetNameNoFormatting]"
				}
				textbox = {
					visible = "[And(Not(NotZero(Treaty.GetBindingDaysLeft)), Or(GreaterThan_CFixedPoint(Abs_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_margin')), '(CFixedPoint)0'), GreaterThan_CFixedPoint(Abs_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_money')), '(CFixedPoint)0')))]"
					parentanchor = vcenter
					autoresize = yes
					align = nobaseline
					using = elide_fontsize_min
					max_width = 195
					margin_left = 2
					text = "[Treaty.GetNameNoFormatting]"
				}
			}

			### SMART TRADE: net to the player, one column for every row, left of
			### the time remaining. Never further right: the pin star appears
			### there on hover (run 4, Damien's screenshot).
			textbox = {
				visible = "[And(NotZero(Treaty.GetBindingDaysLeft), And(Or(GreaterThan_CFixedPoint(Abs_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_margin')), '(CFixedPoint)0'), GreaterThan_CFixedPoint(Abs_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_money')), '(CFixedPoint)0')), GreaterThan_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_has_lane'), '(CFixedPoint)0')))]"
				position = { -52 0 }
				parentanchor = right|vcenter
				autoresize = yes
				align = nobaseline
				using = fontsize_small
				raw_text = "@money![Add_CFixedPoint(Subtract_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_margin'), Multiply_CFixedPoint(Treaty.GetShippingLaneOf(GetPlayer.Self).GetMerchantMarineDemandRaw, GetGoods('merchant_marine').WithMarketContext(GetPlayer.GetMarket.Self).GetMarketPrice)), Treaty.MakeScope.ScriptValue('st_treaty_money'))|D+=]"
				tooltipwidget = { smart_trade_treaty_tooltip = {} }
			}
			textbox = {
				visible = "[And(NotZero(Treaty.GetBindingDaysLeft), And(Or(GreaterThan_CFixedPoint(Abs_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_margin')), '(CFixedPoint)0'), GreaterThan_CFixedPoint(Abs_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_money')), '(CFixedPoint)0')), Not(GreaterThan_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_has_lane'), '(CFixedPoint)0'))))]"
				position = { -52 0 }
				parentanchor = right|vcenter
				autoresize = yes
				align = nobaseline
				using = fontsize_small
				raw_text = "@money![Add_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_margin'), Treaty.MakeScope.ScriptValue('st_treaty_money'))|D+=]"
				tooltipwidget = { smart_trade_treaty_tooltip = {} }
			}
			textbox = {
				visible = "[And(Not(NotZero(Treaty.GetBindingDaysLeft)), And(Or(GreaterThan_CFixedPoint(Abs_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_margin')), '(CFixedPoint)0'), GreaterThan_CFixedPoint(Abs_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_money')), '(CFixedPoint)0')), GreaterThan_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_has_lane'), '(CFixedPoint)0')))]"
				position = { -52 0 }
				parentanchor = right|vcenter
				autoresize = yes
				align = nobaseline
				using = fontsize_small
				raw_text = "@money![Add_CFixedPoint(Subtract_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_margin'), Multiply_CFixedPoint(Treaty.GetShippingLaneOf(GetPlayer.Self).GetMerchantMarineDemandRaw, GetGoods('merchant_marine').WithMarketContext(GetPlayer.GetMarket.Self).GetMarketPrice)), Treaty.MakeScope.ScriptValue('st_treaty_money'))|D+=]"
				tooltipwidget = { smart_trade_treaty_tooltip = {} }
			}
			textbox = {
				visible = "[And(Not(NotZero(Treaty.GetBindingDaysLeft)), And(Or(GreaterThan_CFixedPoint(Abs_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_margin')), '(CFixedPoint)0'), GreaterThan_CFixedPoint(Abs_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_money')), '(CFixedPoint)0')), Not(GreaterThan_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_has_lane'), '(CFixedPoint)0'))))]"
				position = { -52 0 }
				parentanchor = right|vcenter
				autoresize = yes
				align = nobaseline
				using = fontsize_small
				raw_text = "@money![Add_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_margin'), Treaty.MakeScope.ScriptValue('st_treaty_money'))|D+=]"
				tooltipwidget = { smart_trade_treaty_tooltip = {} }
			}

			textbox = {
				visible = "[NotZero(Treaty.GetBindingDaysLeft)]"
				position = { -20 0 }
				align = nobaseline
				parentanchor = right|vcenter
				autoresize = yes
				using = elide_fontsize_min
				max_width = 25
				text = "[LabelingHelper.GetRemainingDuration(Treaty.GetBindingPeriodEndGameDate.Self, '_SHORT')]"
			}
		}
	}
}

types article_input_types {
	# Vanilla's goods picker list, copied verbatim at generation time from
	# gui/right_click_menu.gui:10047-10369, plus the gain figure.
	type article_input_goods_list = dynamicgridbox {
		datamodel_wrap = 4
		flipdirection = yes

		item = {
			container = {
				grid_button = {
					visible = "[Not(ObjectsEqual(ArticleDraft.GetGoods.Self, Goods.Self))]"
					using = tooltip_ne
					datacontext = "[ArticleDraft.GetArticleType]"

					tooltipwidget = {
						FancyTooltip_Goods = {
							blockoverride "goods_interactions" {}
							blockoverride "goods_trend" {}

							blockoverride "tooltip_content_before_before" {
								flowcontainer = {
									visible = "[And(Not(PdxGuiWidget.HasContext('WarGoalDraft')), TreatyDraft.GetRightCountry.IsAI)]"
									spacing = 5
									tooltip = "[TreatyDraft.GetArticleTypeAcceptanceBreakdownWithGood(ArticleType.Self, Country.Self, Goods.Self)]"

									treaty_draft_input_acceptance_button_icon = {}

									custom_tooltip_textbox = {
										parentanchor = vcenter
										max_width = 500
										text = "TREATY_DRAFT_ACCEPTANCE_WITH_LABEL_GOODS"
									}
								}
							}

							### The below two blockoverrides is to always show the local player's market on the left
							blockoverride "state_price_card" {
								container = {
									visible = "[Not(PdxGuiWidget.HasContext('WarGoalDraft'))]"

									market_price_card = {
										visible = "[Country.IsLocalPlayer]"
									}

									market_price_card = {
										visible = "[Not(Country.IsLocalPlayer)]"
										datacontext = "[Goods.WithMarketContext(TreatyDraft.GetOtherCountry(Country.Self).GetMarket.Self)]"
									}
								}

								container = {
									visible = "[PdxGuiWidget.HasContext('WarGoalDraft')]"

									market_price_card = {
										datacontext = "[Goods.WithMarketContext(WarGoalDraft.GetHolder.GetMarket.Self)]"
									}
								}
							}

							blockoverride "market_price_card" {
								container = {
									visible = "[Not(PdxGuiWidget.HasContext('WarGoalDraft'))]"

									market_price_card = {
										visible = "[Not(Country.IsLocalPlayer)]"
									}

									market_price_card = {
										visible = "[Country.IsLocalPlayer]"
										datacontext = "[Goods.WithMarketContext(TreatyDraft.GetOtherCountry(Country.Self).GetMarket.Self)]"
									}
								}

								container = {
									visible = "[PdxGuiWidget.HasContext('WarGoalDraft')]"

									market_price_card = {
										datacontext = "[Goods.WithMarketContext(WarGoalDraft.GetTarget.GetMarket.Self)]"
									}
								}
							}
						}
					}

					blockoverride "min_width" {
						min_width = 100
					}

					blockoverride "properties" {
						onclick = "[ArticleDraft.SetGood(Goods.Self)]"
					}

					blockoverride "texture" {
						texture = "[Goods.GetTexture]"
					}

					blockoverride "text_middle" {
						text = "[Goods.GetNameNoFormatting]"
					}

					blockoverride "text_bottom" {
						widget = {
							size = { 100% 20 }
							parentanchor = bottom
							position = { 0 -3 }

							article_market_goods_numbers = {
								visible = "[Not(PdxGuiWidget.HasContext('WarGoalDraft'))]"
							}

							article_market_goods_numbers = {
								visible = "[PdxGuiWidget.HasContext('WarGoalDraft')]"

								blockoverride "left_market_number" {
									article_market_goods_balance_number = {
										datacontext = "[Goods.WithMarketContext(WarGoalDraft.GetHolder.GetMarket.Self)]"
									}
								}

								blockoverride "right_market_number" {
									article_market_goods_balance_number = {
										datacontext = "[Goods.WithMarketContext(WarGoalDraft.GetTarget.GetMarket.Self)]"
									}
								}
							}
						}
					}

					blockoverride "additional_widgets" {
						### SMART TRADE: best weekly gain for this good (estimate).
						### Clicking it picks the good AND sets its best quantity,
						### the same two things the player would do by hand.
						button = {
							visible = "[And(And(ArticleDraft.HasType('goods_transfer'), ArticleDraft.GetFirstOrSource.IsLocalPlayer), GreaterThan_CFixedPoint(Subtract_CFixedPoint(Subtract_CFixedPoint(Goods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketPrice, Goods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketPrice), Select_CFixedPoint(GetScriptedGui('st_markets_adjacent_sgui').IsValid(GuiScope.SetRoot(ArticleDraft.GetFirstOrSource.MakeScope).AddScope('st_other', ArticleDraft.GetSecondOrTarget.MakeScope).End), '(CFixedPoint)0', Multiply_CFixedPoint(Divide_CFixedPoint(GetGoods('merchant_marine').WithMarketContext(GetPlayer.GetMarket.Self).GetMarketPrice, Goods.GetTradedQuantity), '(CFixedPoint)1.25'))), '(CFixedPoint)0'))]"
