						raw_text = "#bold Net: @money![Multiply_CFixedPoint(Article.GetQuantity, Subtract_CFixedPoint(Article.GetGoods.WithMarketContext(Article.GetTargetCountry.GetMarket.Self).GetMarketPrice, Article.GetGoods.WithMarketContext(Article.GetSourceCountry.GetMarket.Self).GetMarketPrice))|D+=] a week#! (@money![Divide_CFixedPoint(Multiply_CFixedPoint(Article.GetQuantity, Subtract_CFixedPoint(Article.GetGoods.WithMarketContext(Article.GetTargetCountry.GetMarket.Self).GetMarketPrice, Article.GetGoods.WithMarketContext(Article.GetSourceCountry.GetMarket.Self).GetMarketPrice)), Article.GetQuantity)|2+=] a unit)"
