	type smart_trade_treaty_tooltip = RegularTooltip {
		blockoverride "tooltip_content" {
			flowcontainer = {
				direction = vertical
				minimumsize = { 300 -1 }

				custom_tooltip_textbox = { raw_text = "#header Net to your treasury, per week#!" }
				custom_tooltip_textbox = {
					visible = "[GreaterThan_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_has_lane'), '(CFixedPoint)0')]"
					raw_text = "Goods you send: @money![Subtract_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_margin'), Multiply_CFixedPoint(Treaty.GetShippingLaneOf(GetPlayer.Self).GetMerchantMarineDemandRaw, GetGoods('merchant_marine').WithMarketContext(GetPlayer.GetMarket.Self).GetMarketPrice))|D+=] (after shipping)"
				}
				custom_tooltip_textbox = {
					visible = "[Not(GreaterThan_CFixedPoint(Treaty.MakeScope.ScriptValue('st_treaty_has_lane'), '(CFixedPoint)0'))]"
					raw_text = "Goods you send: @money![Treaty.MakeScope.ScriptValue('st_treaty_margin')|D+=]"
				}
				custom_tooltip_textbox = { raw_text = "Money transfers: @money![Treaty.MakeScope.ScriptValue('st_treaty_money')|D+=]" }
				custom_tooltip_textbox = { raw_text = "Hover a goods transfer for its breakdown." }
			}
		}
	}

