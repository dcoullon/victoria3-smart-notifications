									blockoverride "line_button_icon_texture" {
										visible = no
									}

									blockoverride "line_button_selected" {
										visible = "[Not(GetVariableSystem.Exists( 'hide_prestige_goods' ))]"
									}
								}

								building_browser_filter_line_button = {
									align = hcenter|nobaseline
									text = "HIDE"

									blockoverride "line_button_tooltip" {}

									blockoverride "line_button_onclick" {
										onclick = "[GetVariableSystem.Set( 'hide_prestige_goods', 'true' )]"
									}

									blockoverride "line_button_icon_texture" {
										visible = no
									}

									blockoverride "line_button_selected" {
										visible = "[GetVariableSystem.Exists( 'hide_prestige_goods' )]"
									}
								}
							}
						}

						flowcontainer = {
							visible = "[And(InformationPanel.IsTabSelected('world_market_trade'), GreaterThan_int32(GetDataModelSize(MarketPanel.AccessWorldMarketHubs), '(int32)0'))]"
							minimumsize = { @panel_width 38 }
							parentanchor = hcenter
							spacing = 2
							margin = { 2 0 }

							textbox = {
								size = { 132 38 }
								margin = { 8 8 }
								align = nobaseline
								alpha = 0.5
								using = elide_fontsize_min
								text = "concept_world_market_hub"
							}

							button = {
								size = { 402 38 }
								parentanchor = vcenter
								onclick = "[MarketPanel.ToggleWorldMarketHubFilter(PdxGuiWidget.AccessSelf)]"
								using = default_button
								using = tooltip_ne
								tooltip = "MARKET_WORLD_MARKET_HUB_FILTER_TOOLTIP"

								textbox = {
									size = { 100% 100% }
									margin = { 20 0 }
									align = hcenter|nobaseline
									using = elide_fontsize_min
									text = "MARKET_WORLD_MARKET_HUB_FILTER_LABEL"
								}

								action_selection_number = {
									blockoverride "text" {
										text = "[GetDataModelSize(MarketPanel.AccessWorldMarketHubs)|+]"
									}
								}
							}
						}
					}
				}

				flowcontainer = {
					visible = "[InformationPanel.IsTabSelected('world_market_trade')]"
					direction = vertical
					parentanchor = hcenter
					margin_bottom = 10

					section_header_button = {					
						blockoverride "left_text" {
							using = elide_fontsize_min
							text = "CHARTS"
						}

						blockoverride "onclick" {
							onclick = "[GetVariableSystem.Toggle( 'market_world_market_charts' )]"
						}
						
						blockoverride "onclick_showmore" {
							visible = "[GetVariableSystem.Exists( 'market_world_market_charts' )]" # Flipped to show by Default
						}

						blockoverride "onclick_showless" {
							visible = "[Not(GetVariableSystem.Exists( 'market_world_market_charts' ))]" # Flipped to show by Default
						}
					}

					flowcontainer = {
						visible = "[Not(GetVariableSystem.Exists( 'market_world_market_charts' ))]" # Flipped to show by Default
						parentanchor = hcenter
						spacing = 5
						margin_top = 5

						compact_chart = {
							blockoverride "datamodel" {
								datamodel = "[MarketPanel.AccessGoodsSortedOnExports]"
							}

							blockoverride "show_more_button_visibility" {
								visible = "[GreaterThan_int32(GetDataModelSize(Market.AccessMarketGoods( MarketPanel.GetFilters )), '(int32)3')]"
							}

							blockoverride "heading" {
								text = "EXPORTS"
							}

							blockoverride "tooltip" {
								tooltip = "WORLD_MARKET_GOODS_EXPORT_TOOLTIP"

								tooltipwidget = {
									RegularTooltip_MarketWorldMarketExportsTo = {
										blockoverride "partners" {
											datamodel = "[MarketPanel.AccessImportersFromMarket(Goods.Self)]"
										}

										blockoverride "partner_amount" {
											text = "[MarketPanel.GetExportedAmountToPartner(Market.Self, Goods.Self)|v1]"
										}

										blockoverride "partner_trade_values" {
											text = "MARKET_PANEL_PARTNER_TRADE_VALUES"
										}

										blockoverride "additional_trade_visibility" {
											visible = "[And(Not(MarketPanel.HasSelectedWorldMarketHub), GreaterThan_CFixedPoint(Goods.GetWorldMarketAdditionalExportsFromMarket, '(CFixedPoint)0'))]"
										}
									}
								}
							}

							blockoverride "pieslice" {
								value = "[MarketPanel.GetExportedAmount(Goods.Self)]"
							}

							blockoverride "color" {
								color = "[Goods.GetColor]"
							}
							
							blockoverride "pie_item_goto_button" {
								button = {
									size = { 100% 100% }
									onclick = "[InformationPanelBar.OpenGoodsPanel(Market.Self, Goods.Self)]"
									using = clean_button
								}
							}

							blockoverride "leftside_info" {
								text = "[Goods.GetName]"
							}

							blockoverride "rightside1_info" {
								text = "[Goods.GetTextIcon] [MarketPanel.GetExportedAmount(Goods.Self)|vD]"
							}

							blockoverride "rightside2_info" {
								visible = no
							}
						}

						compact_chart = {
							blockoverride "datamodel" {
								datamodel = "[MarketPanel.AccessGoodsSortedOnImports]"
							}

							blockoverride "show_more_button_visibility" {
								visible = "[GreaterThan_int32(GetDataModelSize(Market.AccessMarketGoods( MarketPanel.GetFilters )), '(int32)3')]"
							}

							blockoverride "heading" {
								text = "IMPORTS"
							}

							blockoverride "tooltip" {
								tooltip = "WORLD_MARKET_GOODS_IMPORT_TOOLTIP"

								tooltipwidget = {
									RegularTooltip_MarketWorldMarketImportsFrom = {
										blockoverride "partners" {
											datamodel = "[MarketPanel.AccessExportersToMarket(Goods.Self)]"
										}

										blockoverride "partner_amount" {
											text = "[MarketPanel.GetImportedAmountFromPartner(Market.Self, Goods.Self)|v1]"
										}

										blockoverride "partner_trade_values" {
											text = "MARKET_PANEL_PARTNER_TRADE_VALUES"
										}

										blockoverride "additional_trade_visibility" {
											visible = "[And(Not(MarketPanel.HasSelectedWorldMarketHub), GreaterThan_CFixedPoint(Goods.GetWorldMarketAdditionalImportsToMarket, '(CFixedPoint)0'))]"
										}
									}
								}
							}

							blockoverride "pieslice" {
								value = "[MarketPanel.GetImportedAmount(Goods.Self)]"
							}

							blockoverride "color" {
								color = "[Goods.GetColor]"
							}
							
							blockoverride "pie_item_goto_button" {
								button = {
									size = { 100% 100% }
									onclick = "[InformationPanelBar.OpenGoodsPanel(Market.Self, Goods.Self)]"
									using = clean_button
								}
							}

							blockoverride "leftside_info" {
								text = "[Goods.GetName]"
							}

							blockoverride "rightside1_info" {
								text = "[Goods.GetTextIcon] [MarketPanel.GetImportedAmount(Goods.Self)|vD]"
							}

							blockoverride "rightside2_info" {
								visible = no
							}
						}
					}
				}
			}

			flowcontainer = {
				visible = "[InformationPanel.IsTabSelected('default')]"

				sort_button = {
					onclick = "[Market.Sort('name')]"
					onclick = "[Market.RestoreSort]"
					tooltip = "SORT_BY_MARKET_GOODS"
					size = { 50 20 }

					button = {
						texture = "gfx/interface/buttons/sort_button_icons/sort_icon_good.dds"
						size = { 25 25 }
						parentanchor = center
						alwaystransparent = yes
					}
				}

				sort_button = {
					text = "[concept_market_price]"
					onclick = "[Market.Sort('price')]"
					onclick = "[Market.RestoreSort]"
					
					size = { 210 20 }
					align = hcenter|nobaseline
				}

				sort_button = {
					#text = "BALANCE"
					onclick = "[Market.Sort('balance')]"
					onclick = "[Market.RestoreSort]"
					tooltip = "SORT_BY_BALANCE_TOOLTIP"
					
					align = hcenter|nobaseline
					size = { 100 20 }
