					}
				}

				sort_button = {
					name = "tutorial_highlight_market_details_panel_buy_orders"
					onclick = "[Market.Sort('buy')]"
					onclick = "[Market.RestoreSort]"
					tooltip = "SORT_BY_BUY_ORDERS"
					
					align = hcenter|nobaseline
					size = { 90 20 }
